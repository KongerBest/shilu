@import './styles/tokens.wxss';

page {
  background: var(--c-bg);
  color: var(--c-text);
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

/* 页面统一内边距与底部给自定义 tabbar 留白（tabbar 实际高度 = 108rpx + 安全区）
   注意：深色主题下必须自己铺底色。原生 page 的背景来自 page{} 选择器，
   拿不到 .theme-dark 上的变量，只靠它会留下浅色底 + 浅色文字的「隐形文字」。 */
.page {
  min-height: 100vh;
  background-color: var(--c-bg);
  /* 三团环境光：让半透明卡片有可见的折射来源，也是「不空」的底层质感。
     用 rgba(0,0,0,0) 而不是 transparent，避免部分 Android WebView 出现灰边。 */
  background-image:
    radial-gradient(145% 85% at 2% -8%, var(--glow-1) 0%, rgba(0, 0, 0, 0) 64%),
    radial-gradient(105% 72% at 104% -2%, var(--glow-2) 0%, rgba(0, 0, 0, 0) 60%),
    radial-gradient(140% 92% at 50% 106%, var(--glow-3) 0%, rgba(0, 0, 0, 0) 66%),
    var(--bg-gradient);
  background-repeat: no-repeat;
  color: var(--c-text);
  padding: var(--sp-4) var(--sp-4)
    calc(var(--tabbar-height) + env(safe-area-inset-bottom) + var(--sp-6));
  /* 切 tab 走 reLaunch，原生层会闪一下；整页淡入把它盖住。
     只动 opacity 不动 transform —— 带 transform 会让 fixed 的 tabbar 以容器为参照跑偏 */
  animation: page-fade-in var(--dur-base) var(--ease-out);
}

@keyframes page-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.page--flush {
  padding-left: 0;
  padding-right: 0;
}

.section {
  margin-bottom: var(--sp-6);
}

.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--sp-3);
}

.section__title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
  letter-spacing: 0.02em;
}

.section__action {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.card {
  /* 玻璃卡片：半透明渐变 + 顶部 1rpx 内高光 + 亮色描边，
     模拟光线从上方掠过玻璃边缘的那道亮线。 */
  background-color: var(--glass-bg);
  background-image:
    linear-gradient(118deg, var(--glass-specular) 0%, rgba(255, 255, 255, 0) 26%),
    linear-gradient(158deg, var(--glass-bg-strong) 0%, var(--glass-bg) 62%);
  border-radius: 24rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-highlight), var(--glass-ring);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  padding: var(--sp-4);
}

.card + .card {
  margin-top: var(--sp-3);
}

.divider {
  height: 1rpx;
  background: var(--c-line);
  margin: var(--sp-3) 0;
}

.muted {
  color: var(--c-text-3);
}

.tabular {
  font-variant-numeric: tabular-nums;
}

/* 重置 button 默认样式，避免各机型外观不一致 */
.btn-reset {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

.btn-reset::after {
  border: none;
}

/* ---------- 通用表单 ---------- */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--c-line);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  flex-shrink: 0;
  font-size: var(--fs-body);
  color: var(--c-text);
}

.form-label-group {
  display: flex;
  flex-direction: column;
}

.form-label-desc {
  margin-top: 2rpx;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.form-input {
  flex: 1;
  margin-left: var(--sp-4);
  text-align: right;
  font-size: var(--fs-body);
  color: var(--c-text);
}

.form-placeholder {
  color: var(--c-text-3);
}

.form-picker {
  display: flex;
  align-items: center;
  margin-left: var(--sp-4);
}

.form-picker-text {
  font-size: var(--fs-body);
  color: var(--c-text-2);
}

.chevron {
  margin-left: var(--sp-1);
  font-size: 32rpx;
  color: var(--c-text-3);
}

.form-error {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--c-danger);
}

.form-hint {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-micro);
  line-height: 1.5;
  color: var(--c-text-3);
}

/* ---------- 标签 ---------- */
.tag {
  margin-left: var(--sp-1);
  padding: 0 10rpx;
  font-size: var(--fs-micro);
  line-height: 32rpx;
  border-radius: var(--radius-pill);
}

.tag--danger {
  color: var(--c-danger);
  background: rgba(194, 76, 63, 0.08);
}

.tag--warn {
  color: var(--c-warn);
  background: rgba(192, 138, 46, 0.1);
}

.tag--accent {
  color: var(--c-accent);
  background: var(--c-accent-soft);
}

/* ---------- 按钮 ---------- */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  padding: 0;
  margin-top: var(--sp-4);
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: 0.04em;
  line-height: 1;
  color: var(--c-on-accent);
  /* 液态玻璃主按钮：半透明主色透出环境光 + 左上斜向高光 + 亮色描边 + 内高光/投影双层 */
  background-color: var(--c-accent-glass);
  background-image:
    linear-gradient(118deg, var(--glass-specular) 0%, rgba(255, 255, 255, 0) 34%),
    linear-gradient(180deg, var(--c-accent-glass-bright) 0%, var(--c-accent-glass) 100%);
  border: 1rpx solid var(--glass-border);
  border-radius: 22rpx;
  box-shadow: var(--shadow-accent), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  transition: transform 140ms ease, box-shadow 140ms ease, opacity 140ms ease;
}

.btn-primary::after {
  border: none;
}

/**
 * 微信基础样式里有 `button:not([size]) { width: 184px }`（特异性 0,1,1），
 * 单类选择器（0,1,0）压不住它，主按钮会固定成 184px 而不是通栏。
 * 双类把特异性提到 0,2,0，稳定胜出；不用 !important 以免后续无法覆盖。
 */
.btn-primary.btn-primary {
  width: 100%;
}

.btn-primary--hover {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: var(--glass-highlight);
}

.btn-primary[disabled] {
  opacity: 0.45;
  color: var(--c-on-accent);
  box-shadow: none;
}

.btn-primary--half {
  flex: 1;
  margin-top: 0;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 96rpx;
  padding: 0;
  margin-right: var(--sp-2);
  font-size: var(--fs-body);
  line-height: 1;
  color: var(--c-text-2);
  background-color: var(--glass-bg-soft);
  background-image: linear-gradient(180deg, var(--glass-bg-strong), var(--glass-bg-soft));
  border: 1rpx solid var(--glass-border);
  border-radius: 22rpx;
  box-shadow: var(--glass-highlight), var(--glass-ring);
  transition: background-color 140ms ease, opacity 140ms ease;
}

.btn-ghost::after {
  border: none;
}

.btn-ghost--hover {
  background-color: var(--glass-bg);
}

.link {
  font-size: var(--fs-caption);
  color: var(--c-accent);
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--c-text-3);
  background: var(--glass-bg-soft);
  border: 1rpx solid var(--glass-border-soft);
  border-radius: 16rpx;
}

.icon-btn--danger {
  color: var(--c-danger);
}

/* ---------- 底部弹层 ---------- */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(16, 18, 20, 0.34);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  padding: var(--sp-4) var(--sp-4) calc(var(--sp-4) + env(safe-area-inset-bottom));
  background-color: var(--glass-bg-strong);
  background-image: linear-gradient(180deg, var(--glass-bg-strong), var(--glass-bg));
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border-top: 1rpx solid var(--glass-border);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: var(--glass-shadow-lg), var(--glass-highlight), var(--glass-ring);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--sp-3);
  border-bottom: 1rpx solid var(--c-line);
}

.sheet-title {
  font-size: var(--fs-title);
  font-weight: 600;
}

.sheet-close {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.sheet-body {
  flex: 1;
  max-height: 62vh;
}

.sheet-foot {
  display: flex;
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--c-line);
}

