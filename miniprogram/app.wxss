/**
 * 全局样式：WEUI 单一视觉源。
 *
 * 1. 官方 weui-wxss v2.5.0（styles/weui.wxss）提供全部组件样式与设计变量；
 * 2. styles/tokens.wxss 把旧语义变量映射到 WEUI 变量；
 * 3. 本节是「兼容层」：旧页面里残留的自定义类名全部按 WEUI 规范重新实现，
 *    已删除渐变、玻璃折射、磨砂、大圆角、投影与整页动效。
 *    新写的页面一律直接使用 weui-* 组件类。
 */
@import './styles/weui.wxss';
@import './styles/tokens.wxss';

page {
  background-color: var(--weui-BG-0);
  color: var(--weui-FG-0);
  font-family: var(--font-sans);
  font-size: 17px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button,
icon,
image,
scroll-view {
  box-sizing: border-box;
}

/* ---------- 页面容器：WEUI 灰底 + 内容白块 ---------- */
/* 横向留白统一由这里提供：页面内所有直接子元素（工具栏、卡片、按钮、提示文）
   自动获得同一条左边线，不再各写一套 padding。 */
.page {
  min-height: 100vh;
  padding: 0 var(--page-gutter) calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 48rpx);
  max-width: var(--page-max);
  margin: 0 auto;
  background-color: var(--weui-BG-0);
  color: var(--weui-FG-0);
}

/* 全宽页面（通栏图 / 文档）用 .page--flush 关掉横向留白，
   同时要自己保证内容不贴边；默认不要用。 */
.page--flush {
  --page-gutter: 0px;
}

/* ---------- 分组标题（对应 WEUI Cells 标题） ---------- */
.section {
  margin: 0 0 32rpx;
}

.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding: 0 32rpx;
}

.section__title {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--weui-FG-1);
}

.section__title.weui-cells__title {
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--weui-FG-1);
}

.section__title.weui-cells__title::before {
  display: none;
}

.section__action {
  font-size: 26rpx;
  color: var(--weui-FG-2);
}

/* WEUI Cell 自带 :before 顶部分隔线，旧列表的 border-bottom 会让行间出现双线。
   双类选择器压过页面 WXSS 的单类规则。 */
.weui-cell.weui-cell {
  border-bottom: none;
  font-size: 17px;
}

/* ---------- 内容块：大 R 角白色卡片 ---------- */
/* 原 WEUI 通栏平面靠上下两条贯穿线分隔；改成独立卡片后，
   用一整圈 1px 描边勾出圆角边界（暗色底上也能看清形状），
   上下两条贯穿线随之移除，否则会从圆弧里穿出去。 */
.card {
  margin: 0 0 32rpx;
  padding: 0 32rpx;
  background-color: var(--weui-BG-2);
  border: 1rpx solid var(--weui-FG-3);
  border-radius: var(--radius-card);
  /* 让内部行的底色与分隔线跟着圆弧裁切，避免直角盖住圆角 */
  overflow: hidden;
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.card + .card {
  margin-top: 0;
}

/* 卡片首行的 WEUI 顶部分隔线会从左 16px 一直画到右边缘，
   在圆角处形成一段突兀的直线，必须去掉（行间分隔仍由后续行保留）。 */
.card > .weui-cell:first-child::before,
.card > .weui-cell:first-child:before {
  display: none;
}

.divider {
  height: 1rpx;
  background-color: var(--weui-FG-3);
  margin: 0 0 0 32rpx;
}

.muted {
  color: var(--weui-FG-2);
}

.tabular {
  font-variant-numeric: tabular-nums;
}

/* ---------- 按钮：统一到 WEUI Button ---------- */
/* WEUI 按钮默认 184px 居中；主操作按钮通栏。
   左右边距交给 .page 的 --page-gutter，这里不再叠加第二层内缩。 */
.weui-btn.weui-btn {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  /* WEUI 官方是 8px 小圆角，这里统一到大 R 角分档里的控件级 */
  border-radius: var(--radius-control);
}

.page > .weui-btn.weui-btn,
.section > .weui-btn.weui-btn {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
}

/* 露在卡片外的说明文字也要有 WEUI 的 16px 页边距 */
.section > .form-hint,
.section > .note,
.page > .form-hint,
.page > .note {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.btn-primary,
.btn-ghost {
  border-radius: var(--radius-control);
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  background-image: none;
  border: 0;
  font-weight: 500;
  letter-spacing: 0;
}

.btn-primary {
  background-color: var(--weui-BRAND);
  color: #ffffff;
}

.btn-primary[disabled] {
  opacity: 0.4;
  background-color: var(--weui-BRAND);
  color: #ffffff;
}

.btn-ghost {
  background-color: var(--weui-BTN-DEFAULT-BG);
  color: var(--weui-FG-0);
}

/* hover 反馈：WEUI 的按压态，不用位移/缩放 */
.btn-primary--hover,
.btn-ghost--hover,
.chip--hover,
.row--hover,
.crow--hover,
.arow--hover,
.hit--hover,
.theme-opt--hover,
.action-btn--hover,
.grid__item--hover,
.contact-entry--hover,
.crypto-note--hover,
.reminder__btn--hover,
.chip--cat.is-active,
.tabbar__item--hover,
.empty__action--hover,
.fab--hover,
.tile--hover,
.cal__nav--hover,
.mode--hover,
.action--hover,
.sbar__clear--hover,
.cancel--hover,
.errorbox__btn--hover,
.contact-link--hover,
.hero__name--hover,
.remind__chip--hover,
.theme-opt--hover,
.contact-pick--hover {
  opacity: 0.7;
  transform: none;
  background-color: var(--weui-BG-COLOR-ACTIVE);
}

.btn-primary--half {
  flex: 1;
  margin-top: 0;
}

/* 弹层底部等分按钮 */
.sheet-foot .weui-btn.weui-btn {
  width: auto;
  flex: 1;
  margin-top: 0;
}

.sheet-foot .weui-btn.weui-btn + .weui-btn.weui-btn {
  margin-left: 16rpx;
}

.btn-reset {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

.btn-reset::after {
  border: none;
}

.link {
  font-size: 28rpx;
  color: var(--weui-LINK);
}

.link--danger {
  color: var(--weui-RED);
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
  color: var(--weui-FG-1);
  background-color: var(--weui-BG-1);
  border: 1rpx solid var(--weui-FG-3);
  border-radius: var(--radius-sm);
}

.icon-btn--danger {
  color: var(--weui-RED);
}

/* ---------- 表单：对应 WEUI Cell / Form ---------- */
.form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--weui-FG-3);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  flex-shrink: 0;
  font-size: 32rpx;
  color: var(--weui-FG-0);
}

.form-label-group {
  display: flex;
  flex-direction: column;
}

.form-label-desc {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

.form-input {
  flex: 1;
  min-height: 56rpx;
  margin-left: 24rpx;
  text-align: right;
  font-size: 32rpx;
  color: var(--weui-FG-0);
  background: transparent;
}

.form-placeholder {
  color: var(--weui-FG-2);
}

.form-picker {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.form-picker-text {
  font-size: 32rpx;
  color: var(--weui-FG-1);
}

.chevron {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: var(--weui-FG-2);
}

/* WEUI Cell 的右侧箭头：用文字而非自造 CSS 图形，跨页面表现一致 */
.weui-arrow {
  display: inline-block;
  min-width: 24rpx;
  text-align: right;
  font-size: 34rpx;
  line-height: 1;
  color: var(--weui-FG-2);
}

.form-error {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--weui-RED);
}

.form-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--weui-FG-2);
}

/* ---------- 徽章 / 标签：对应 WEUI Badge ---------- */
.tag {
  margin-left: 8rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  border-radius: var(--radius-pill);
  background-color: var(--weui-TAG-BACKGROUND-BLACK);
  color: var(--weui-TAG-TEXT-BLACK);
}

.tag--danger {
  color: var(--weui-RED);
  background-color: var(--weui-TAG-BACKGROUND-ORANGE);
}

.tag--warn {
  color: var(--weui-TAG-TEXT-ORANGE);
  background-color: var(--weui-TAG-BACKGROUND-ORANGE);
}

.tag--accent {
  color: var(--weui-TAG-TEXT-GREEN);
  background-color: var(--weui-TAG-BACKGROUND-GREEN);
}

/* ---------- 可选 chips：WEUI 无 chip，用中性描边 + WEUI 色 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 8rpx 24rpx;
  font-size: 28rpx;
  color: var(--weui-FG-1);
  border: 1rpx solid var(--weui-FG-3);
  border-radius: var(--radius-pill);
  background-color: var(--weui-BG-2);
}

.chip.is-on,
.chip.is-active {
  color: var(--weui-TEXTGREEN);
  border-color: var(--weui-BRAND);
  background-color: var(--weui-TAG-BACKGROUND-GREEN);
}

/* ---------- 半屏弹层：对应 WEUI Half Screen Dialog ---------- */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 1000;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5000;
  display: flex;
  flex-direction: column;
  max-height: 75vh;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background-color: var(--weui-BG-2);
  border-top: 0;
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  -webkit-transform: none;
  transform: none;
}

.sheet.weui-half-screen-dialog {
  -webkit-transform: none;
  transform: none;
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--weui-FG-3);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--weui-FG-0);
}

.sheet-close {
  font-size: 28rpx;
  color: var(--weui-LINK);
}

.sheet-body {
  flex: 1;
  max-height: 56vh;
  padding-top: 16rpx;
}

.sheet-foot {
  display: flex;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--weui-FG-3);
}

/* ---------- WEUI 组件的少量布局适配 ---------- */
/* 官方组件的默认 R 角偏小（按钮 8px、弹窗 12px、搜索框 4px），
   在这里一次性抬到项目的大 R 角分档上。页面里不要再单独覆盖。 */
.weui-btn.weui-btn_mini {
  border-radius: var(--radius-control);
}

.weui-btn.weui-btn_xmini {
  border-radius: var(--radius-sm);
}

.weui-dialog {
  border-radius: var(--radius-sheet);
  overflow: hidden;
}

.weui-toast {
  border-radius: var(--radius-lg);
}

.weui-toptips {
  border-radius: var(--radius-control);
}

.weui-badge.weui-badge {
  border-radius: var(--radius-pill);
}

.weui-search-bar__form,
.weui-search-bar__label {
  border-radius: var(--radius-control);
}

/* 半屏弹层：WEUI 默认只切顶角，这里与自绘 .sheet 对齐 */
.weui-half-screen-dialog {
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
}

.weui-cells {
  margin-top: 0;
  font-size: 17px;
}

.weui-cells__title {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.weui-cell.weui-cell {
  font-size: 17px;
}

.weui-loadmore {
  width: 100%;
  margin: 32rpx auto;
}

.weui-msg {
  padding-top: 96rpx;
}

.weui-badge.weui-badge {
  font-size: 24rpx;
  line-height: 1.4;
}

.weui-search-bar {
  padding: 16rpx 24rpx;
}

.weui-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
}

.weui-navbar {
  background-color: var(--weui-BG-2);
  border-bottom: 1rpx solid var(--weui-FG-3);
}

.weui-navbar__item {
  font-size: 15px;
}

/* ---------- 宽屏适配 ----------
   rpx 会随窗口宽度线性放大：手机、平板、分屏都保持同一套比例留白，
   无需额外断点。但显示器级宽度（≥900px）继续拉伸只会把内容变成一条
   巨型长条，因此限制最大宽度并居中，两侧用同一灰底补齐。 */
@media (min-width: 900px) {
  page {
    --page-gutter: 40px;
    --page-max: 750px;

    /* rpx 会随窗口宽度线性放大：1400px 窗口下 48rpx 会算成约 90px，
       圆角大得像药丸。桌面宽度改用固定 px，与 375px 手机上的观感对齐
       （24rpx = 12px → 这里写 12px，其余同理）。 */
    --radius-xs: 4px;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 24px;
  }
}
