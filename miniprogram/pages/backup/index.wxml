<page-meta
  background-color="{{themeBg}}"
  background-text-style="{{themeBgText}}"
  root-background-color="{{themeBg}}"
  page-style="background-color:{{themeBg}};"
></page-meta>
<view class="page {{themeClass}}" data-weui-theme="{{themeMode || 'light'}}">
  <view class="card">
    <text class="card__title">导出备份</text>
    <text class="form-hint">
      导出分类、模板、资料、人物、纪念日。附件文件不在其中——文件本体在云存储，恢复后需要重新上传。
    </text>

    <button
      class="btn-primary weui-btn weui-btn_primary"
      hover-class="btn-primary--hover"
      loading="{{exporting}}"
      disabled="{{exporting}}"
      bindtap="onExport"
    >{{exporting ? '正在打包' : '生成备份文件'}}</button>

    <block wx:if="{{exportReady}}">
      <view class="meta">
        <view class="meta__row weui-cell">
          <text class="meta__label">文件</text>
          <text class="meta__value">{{fileName}}</text>
        </view>
        <view class="meta__row weui-cell">
          <text class="meta__label">大小</text>
          <text class="meta__value tabular">{{fileSize}}</text>
        </view>
        <view class="meta__row weui-cell">
          <text class="meta__label">时间</text>
          <text class="meta__value tabular">{{exportedAt}}</text>
        </view>
        <view class="meta__row weui-cell">
          <text class="meta__label">内容</text>
          <text class="meta__value">{{total}} 条</text>
        </view>
      </view>

      <view class="tag-row">
        <text class="tag weui-badge">资料 {{counts.records}}</text>
        <text class="tag weui-badge">人物 {{counts.contacts}}</text>
        <text class="tag weui-badge">纪念日 {{counts.anniversaries}}</text>
        <text class="tag weui-badge">分类 {{counts.categories}}</text>
        <text class="tag weui-badge">模板 {{counts.templates}}</text>
      </view>

      <view class="actions">
        <view class="action" bindtap="onShareToChat" hover-class="action--hover">发送到聊天</view>
        <view class="action" bindtap="onSaveToDisk" hover-class="action--hover">存到电脑</view>
        <view class="action" bindtap="onCopyText" hover-class="action--hover">复制内容</view>
      </view>
    </block>
  </view>

  <view class="card">
    <text class="card__title">从备份恢复</text>
    <text class="form-hint">
      默认按原 ID 合并：补齐或覆盖同一条，不动其它数据。也可以选「以备份为准」，把备份之外的内容清理掉。附件不会恢复。
    </text>

    <button
      class="btn-primary weui-btn weui-btn_primary"
      hover-class="btn-primary--hover"
      loading="{{picking}}"
      disabled="{{picking || importing}}"
      bindtap="onChooseFile"
    >选择备份文件</button>

    <view class="link-row" bindtap="onPasteBackup">
      <text class="link">选不到文件？改为粘贴备份内容</text>
    </view>

    <view wx:if="{{preview}}" class="preview">
      <view class="meta">
        <view class="meta__row weui-cell">
          <text class="meta__label">来源</text>
          <text class="meta__value">{{preview.fileName}}</text>
        </view>
        <view class="meta__row weui-cell">
          <text class="meta__label">导出时间</text>
          <text class="meta__value tabular">{{preview.exportedAt}}</text>
        </view>
        <view class="meta__row weui-cell">
          <text class="meta__label">条目</text>
          <text class="meta__value">{{preview.total}} 条</text>
        </view>
      </view>

      <view class="modes">
        <view
          class="mode {{mode === 'merge' ? 'is-on' : ''}}"
          data-mode="merge"
          hover-class="mode--hover"
          bindtap="onModeTap"
        >
          <view class="mode__head">
            <view class="mode__dot"></view>
            <text class="mode__title">合并恢复</text>
          </view>
          <text class="mode__desc">补齐或覆盖同一条，不动其它数据</text>
        </view>

        <view
          class="mode {{mode === 'replace' ? 'is-on' : ''}}"
          data-mode="replace"
          hover-class="mode--hover"
          bindtap="onModeTap"
        >
          <view class="mode__head">
            <view class="mode__dot"></view>
            <text class="mode__title">以备份为准</text>
          </view>
          <text class="mode__desc">备份里没有的内容会被清理</text>
        </view>
      </view>

      <view wx:if="{{mode === 'replace'}}" class="mode-warn">
        恢复时会删除备份之外的内容，此操作无法撤销。
      </view>

      <button
        class="btn-primary weui-btn weui-btn_primary"
        hover-class="btn-primary--hover"
        loading="{{importing}}"
        disabled="{{importing}}"
        bindtap="onStartRestore"
      >{{importing ? '正在恢复' : (mode === 'replace' ? '覆盖恢复' : '开始恢复')}}</button>

      <view wx:if="{{importing}}" class="progress">
        <view class="progress__track">
          <view class="progress__fill" style="width: {{progressPercent}}%"></view>
        </view>
        <text class="progress__text tabular">{{progressLabel}} · {{progressPercent}}%</text>
      </view>
    </view>
  </view>

  <view wx:if="{{result}}" class="notice">{{result}}</view>
  <view wx:if="{{error}}" class="notice notice--error">{{error}}</view>
</view>
