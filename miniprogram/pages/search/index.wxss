.page {
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--sp-6));
}

/* 搜索条吸顶：结果几十行时还能改关键词。

   材质用 --glass-veil-fill 而不是 --glass-bar-fill：
   本页底色是 BG-0 灰，如果吸顶条吃 #f7f7f7 的白玻璃，合成后会比页面亮
   8 个色阶，重新长出上一轮刚去掉的那块「白板」。
   veil 是「页面本色 + 0.72 透明」，只改变虚实、不改变色相：
   滚动时卡片从下面经过，被 20px 模糊柔化成灰雾，搜索框仍是页面上
   唯一一个白色面，层次不乱。 */
.sbar-row {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  /* 页面已有 --page-gutter 横向留白，这里只留纵向间距；
     否则搜索框会比下方卡片多缩进一层，吸顶时更明显 */
  margin: 0;
  padding: var(--sp-3) 0;
  background-color: var(--glass-veil-fill);
  box-shadow: inset 0 1rpx 0 var(--glass-edge-light);
  -webkit-backdrop-filter: blur(var(--glass-bar-blur));
  backdrop-filter: blur(var(--glass-bar-blur));
  backdrop-filter: blur(var(--glass-bar-blur)) saturate(180%);
}

/* 底部渐隐：滚到搜索条下方的内容先被模糊、再被这条 32rpx 的雾带收边，
   避免玻璃条下沿出现一条硬切线。
   模糊失效的平台（模拟器 / 部分安卓）上，它单独负责柔化边界，同样成立。
   未滚动时它叠在同色页面上，肉眼看不见。 */
.sbar-row::after {
  content: '';
  position: absolute;
  top: 100%;
  right: 0;
  left: 0;
  height: var(--sp-4);
  background: linear-gradient(to bottom, var(--glass-veil-fill), transparent);
  pointer-events: none;
}

.sbar-slot {
  flex: 1;
  min-width: 0;
}

.cancel {
  flex-shrink: 0;
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-2);
  font-size: var(--fs-body);
  color: var(--c-accent);
}

.cancel--hover {
  opacity: 0.6;
}

.tip {
  margin: var(--sp-2) 0 0;
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.result-count {
  margin: var(--sp-3) 0 0;
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

/* 列表用卡片，行与行之间只留一条发丝线，避免几十行都套一层投影 */
.list {
  padding: 0;
}

.hit {
  display: flex;
  align-items: center;
  padding: var(--sp-3) var(--sp-4);
  transition: background-color 140ms ease;
}

.hit + .hit {
  border-top: 1rpx solid var(--c-line);
}

.hit--hover {
  background: var(--glass-bg-strong);
}

.hit__glyph {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--sp-3);
  border-radius: var(--radius-circle);
  background-color: var(--c-accent-soft);
  color: var(--c-accent);
  font-size: var(--fs-caption);
  line-height: 64rpx;
  text-align: center;
}

/* 分类/模板是结构性条目，灰底与内容条目区分开，扫列表时更容易分层 */
.hit__glyph--category,
.hit__glyph--template {
  background-color: var(--c-surface-sunken);
  color: var(--c-text-2);
}

.hit__main {
  flex: 1;
  min-width: 0;
}

.hit__title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hit__meta {
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 高亮只染命中片段：加底色比只改字色更快被眼睛抓到 */
.hl {
  color: var(--c-accent);
  background-color: var(--c-accent-glass-soft);
  border-radius: var(--radius-xs);
}

.hit__badge {
  flex-shrink: 0;
  max-width: 180rpx;
  margin-left: var(--sp-2);
  font-size: var(--fs-micro);
  color: var(--c-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.scope {
  margin-top: var(--sp-4);
  padding: var(--sp-4);
}

.scope__title {
  display: block;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--c-text-2);
}

.scope__line {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  line-height: 1.7;
  color: var(--c-text-3);
}

.scope__line--muted {
  opacity: 0.85;
}

.errorbox {
  margin-top: var(--sp-3);
  padding: var(--sp-4);
  border-radius: var(--radius-card);
  background: var(--c-warn-soft);
  border: 1rpx solid var(--c-warn-line);
}

.errorbox__title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-warn-text);
}

.errorbox__desc {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--c-warn-text);
}

.errorbox__btn {
  display: inline-block;
  margin-top: var(--sp-3);
  padding: var(--sp-1) var(--sp-4);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--c-warn-line);
  font-size: var(--fs-caption);
  color: var(--c-warn-text);
}

.errorbox__btn--hover {
  background: var(--c-warn-line);
}
