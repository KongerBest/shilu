<view class="page page--plain {{themeClass}}">
  <view class="section">
    <view class="section__head">
      <text class="section__title">外观</text>
      <text class="section__action">全局生效</text>
    </view>
    <view class="card theme-picker">
      <view
        class="theme-opt {{themeMode === 'light' ? 'is-active' : ''}}"
        data-mode="light"
        bindtap="onThemeTap"
        hover-class="theme-opt--hover"
      >
        <view class="theme-opt__dot theme-opt__dot--light"></view>
        <text class="theme-opt__label">浅色</text>
      </view>
      <view
        class="theme-opt {{themeMode === 'dark' ? 'is-active' : ''}}"
        data-mode="dark"
        bindtap="onThemeTap"
        hover-class="theme-opt--hover"
      >
        <view class="theme-opt__dot theme-opt__dot--dark"></view>
        <text class="theme-opt__label">深色</text>
      </view>
    </view>
  </view>

  <view class="group">
    <view class="row" bindtap="onEditNickname" hover-class="row--hover">
      <text class="row__label">昵称</text>
      <view class="row__right">
        <text class="row__value">{{nickname || '未设置'}}</text>
        <view class="row__arrow"></view>
      </view>
    </view>
    <view class="row" bindtap="onRecalcStats" hover-class="row--hover">
      <text class="row__label">重算统计</text>
      <view class="row__right">
        <text class="row__value">{{recalculating ? '重算中' : '手动校正'}}</text>
        <view class="row__arrow"></view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section__head">
      <text class="section__title">已知限制</text>
      <text class="section__action" bindtap="onCopyLimits">复制</text>
    </view>
    <view class="card limits">
      <view wx:for="{{limits}}" wx:key="*this" class="limit">
        <text class="limit__index tabular">{{index + 1}}</text>
        <text class="limit__text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section__head">
      <text class="section__title">运行状态</text>
    </view>
    <view class="card">
      <view class="kv">
        <text class="kv__k">版本</text>
        <text class="kv__v">v{{version}}</text>
      </view>
      <view class="divider"></view>
      <view class="kv">
        <text class="kv__k">云开发环境</text>
        <text class="kv__v {{cloudReady ? 'is-ok' : 'is-bad'}}">{{cloudReady ? '已配置' : '未配置'}}</text>
      </view>
      <view class="divider"></view>
      <view class="kv">
        <text class="kv__k">保险箱</text>
        <text class="kv__v {{vaultEnabled ? 'is-ok' : 'is-off'}}">{{vaultEnabled ? '已启用' : '当前构建关闭'}}</text>
      </view>
    </view>
  </view>

  <view class="note">
    本页面列出的限制均为真实未完成事项，不随版本宣传口径调整而删除。
  </view>
</view>
