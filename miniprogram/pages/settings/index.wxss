/* 设置页不挂自定义 tabbar，底部只需常规留白 */
.page--plain {
  padding-bottom: var(--sp-6);
}

.group {
  background-color: var(--glass-bg);
  background-image:
    linear-gradient(118deg, var(--glass-specular) 0%, rgba(255, 255, 255, 0) 26%),
    linear-gradient(158deg, var(--glass-bg-strong) 0%, var(--glass-bg) 68%);
  border: 1rpx solid var(--glass-border);
  border-radius: 24rpx;
  box-shadow: var(--glass-shadow), var(--glass-highlight), var(--glass-ring);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 var(--sp-4);
}

.row + .row {
  border-top: 1rpx solid var(--c-line);
}

.row--hover {
  background: var(--glass-bg-strong);
}

.row__label {
  font-size: var(--fs-body);
  color: var(--c-text);
}

.row__right {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.row__value {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.row__arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--c-text-3);
  border-bottom: 2rpx solid var(--c-text-3);
  transform: rotate(-45deg);
}

.limits {
  padding: var(--sp-3) var(--sp-4);
}

.limit {
  display: flex;
  gap: var(--sp-3);
  padding: var(--sp-2) 0;
}

.limit + .limit {
  border-top: 1rpx solid var(--c-line);
}

.limit__index {
  font-size: var(--fs-micro);
  color: var(--c-text-3);
  padding-top: 6rpx;
  flex-shrink: 0;
  width: 32rpx;
}

.limit__text {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--c-text-2);
  line-height: 1.65;
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
}

.kv__k {
  font-size: var(--fs-body);
  color: var(--c-text-2);
}

.kv__v {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.kv__v.is-ok {
  color: var(--c-accent);
}

.kv__v.is-bad {
  color: var(--c-danger);
}

.kv__v.is-off {
  color: var(--c-text-3);
}

.note {
  margin-top: var(--sp-5);
  font-size: var(--fs-micro);
  color: var(--c-text-3);
  line-height: 1.6;
  text-align: center;
}

/* 外观切换：两个等宽选项，用色点暗示效果，避免只靠文字 */
.theme-picker {
  display: flex;
  gap: var(--sp-3);
  padding: var(--sp-3);
}

.theme-opt {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  height: 88rpx;
  border: 1rpx solid var(--glass-border-soft);
  border-radius: 18rpx;
  background: var(--glass-bg-soft);
  box-shadow: var(--glass-highlight), var(--glass-ring);
  transition: border-color 120ms ease, background-color 120ms ease;
}

.theme-opt--hover {
  opacity: 0.7;
}

.theme-opt.is-active {
  border-color: var(--c-accent);
  background: var(--c-accent-glass-soft);
  box-shadow: var(--glass-highlight);
}

.theme-opt__dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.theme-opt__dot--light {
  background: #f7f7f5;
  border: 1rpx solid #d8d8d2;
}

.theme-opt__dot--dark {
  background: #14161a;
  border: 1rpx solid #3a4049;
}

.theme-opt__label {
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.theme-opt.is-active .theme-opt__label {
  color: var(--c-accent);
  font-weight: 600;
}

/* 自定义开关：不用原生 switch，它的 color 只接受字面量，深色下会和主题色脱节 */
.toggle {
  position: relative;
  width: 88rpx;
  height: 50rpx;
  border-radius: var(--radius-pill);
  /* 关闭态必须是「看得见的凹槽」：玻璃底色几乎全透，白滑块会浮在空气里 */
  background: var(--c-surface-sunken);
  border: 1rpx solid var(--c-line);
  transition:
    background-color var(--dur-base) var(--ease-out),
    border-color var(--dur-base) var(--ease-out);
}

.toggle__knob {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--c-knob);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18), 0 0 0 1rpx rgba(0, 0, 0, 0.03);
  transition: transform var(--dur-base) var(--ease-out);
}

.toggle.is-on {
  background: var(--c-accent);
  border-color: var(--c-accent);
  box-shadow: var(--shadow-accent), inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}

.toggle.is-on .toggle__knob {
  transform: translateX(40rpx);
}
