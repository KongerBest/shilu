<view class="page {{themeClass}}" data-weui-theme="{{themeMode || 'light'}}">
  <loading wx:if="{{loading}}" mode="block" text="正在打开资料库" />

  <block wx:elif="{{error}}">
    <view class="errorbox">
      <text class="errorbox__title">{{error}}</text>
      <text class="errorbox__hint">若是首次运行，请先在 miniprogram/config/env.ts 填写云开发环境 ID，并部署云函数。</text>
      <view class="errorbox__btn" bindtap="onRetry">重试</view>
    </view>
  </block>

  <block wx:else>
    <view class="hero">
      <view class="hero__avatar" bindtap="onEditName" hover-class="hero__name--hover">
        <image wx:if="{{avatarFileId}}" class="hero__avatar-img" src="{{avatarFileId}}" mode="aspectFill" />
        <text wx:else>{{initial}}</text>
      </view>
      <view class="hero__text">
        <text class="hero__greet">{{greet}}</text>
        <view class="hero__name" bindtap="onEditName" hover-class="hero__name--hover">
          <text>{{displayName}}</text>
          <view class="hero__pen"></view>
        </view>
      </view>
    </view>

    <view class="stats">
      <view class="stats__item">
        <text class="stats__num tabular">{{stats.records}}</text>
        <text class="stats__label">资料</text>
      </view>
      <view class="stats__sep"></view>
      <view class="stats__item">
        <text class="stats__num tabular">{{stats.attachments}}</text>
        <text class="stats__label">附件</text>
      </view>
      <view class="stats__sep"></view>
      <view class="stats__item">
        <text class="stats__num tabular">{{stats.anniversaries}}</text>
        <text class="stats__label">纪念日</text>
      </view>
    </view>

    <view class="search-wrap">
      <search-bar readonly="{{true}}" value="" placeholder="搜索标题或内容" bind:tap="onSearchTap" />
    </view>

    <view class="contact-entry" bindtap="onContactsTap" hover-class="contact-entry--hover">
      <view class="contact-entry__icon">人</view>
      <view class="contact-entry__main">
        <text class="contact-entry__title">人物档案</text>
        <text class="contact-entry__desc">{{contactsCount > 0 ? contactsCount + ' 位人物 · 生日自动倒数' : '把家人朋友存进来，生日自动倒数'}}</text>
      </view>
      <text class="weui-arrow">›</text>
    </view>

    <view class="section">
      <view class="section__head">
        <view class="section__title weui-cells__title">快捷新增</view>
        <view class="action-btn action-btn--primary" bindtap="onNewTap" hover-class="action-btn--hover">
          <text class="action-btn__plus">+</text>
          <text>新建资料</text>
        </view>
      </view>

      <view class="grid">
        <view
          wx:for="{{categories}}"
          wx:key="_id"
          class="grid__item"
          data-id="{{item._id}}"
          bindtap="onCategoryTap"
          hover-class="grid__item--hover"
        >
          <view class="grid__dot" style="background: {{item.color}}"></view>
          <text class="grid__name">{{item.name}}</text>
          <text class="grid__count tabular">{{item.record_count}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{favorites.length > 0}}" class="section">
      <view class="section__head">
        <view class="section__title weui-cells__title">收藏</view>
        <view class="action-btn" bindtap="onSeeFavorites" hover-class="action-btn--hover">
          <text>查看全部</text>
          <view class="action-btn__arrow"></view>
        </view>
      </view>
      <record-card
        wx:for="{{favorites}}"
        wx:key="_id"
        item="{{item}}"
        bind:tap="onRecordTap"
        class="stack-item"
      />
    </view>

    <view class="section">
      <view class="section__head">
        <view class="section__title weui-cells__title">最近记录</view>
        <view wx:if="{{recent.length > 0}}" class="action-btn" bindtap="onSeeAll" hover-class="action-btn--hover">
          <text>全部</text>
          <view class="action-btn__arrow"></view>
        </view>
      </view>

      <empty-state
        wx:if="{{recent.length === 0}}"
        title="还没有任何资料"
        desc="从一条备忘开始，之后所有证件、文件、人物都可以归档在这里"
        actionText="新建第一条"
        bind:action="onNewTap"
      />
      <block wx:else>
        <record-card
          wx:for="{{recent}}"
          wx:key="_id"
          item="{{item}}"
          bind:tap="onRecordTap"
          class="stack-item"
        />
      </block>
    </view>
  </block>

  <custom-tabbar id="tabbar" current="home" />
</view>
