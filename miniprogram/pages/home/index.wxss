/* 分区标题：主色竖条作视觉锚点，避免整页纯文字 */
.section__head {
  align-items: center;
}

.section__title {
  display: flex;
  align-items: center;
  gap: 18rpx;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
  letter-spacing: 0.04em;
}

.section__title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--c-accent-bright), var(--c-accent));
}

/* 分区右上角动作：胶囊按钮（主操作实心 + 次操作描边），替代纯文字链接 */
.action-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--glass-border-soft);
  background: var(--glass-bg-soft);
  background-image: linear-gradient(180deg, var(--glass-bg-strong), var(--glass-bg-soft));
  box-shadow: var(--glass-highlight);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
  transition: transform 120ms ease, opacity 120ms ease;
}

.action-btn--hover {
  opacity: 0.7;
  transform: scale(0.96);
}

.action-btn--primary {
  color: var(--c-on-accent);
  border-color: var(--c-accent);
  background: var(--c-accent);
  background-image: linear-gradient(180deg, var(--c-accent-bright), var(--c-accent));
  box-shadow: var(--shadow-accent), inset 0 1rpx 0 rgba(255, 255, 255, 0.26);
}

.action-btn__plus {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.action-btn__arrow {
  width: 11rpx;
  height: 11rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(-45deg);
}

.hero {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-5) 0 var(--sp-4);
}

/* 首字母头像：不用图片，避免阶段三之前的头像上传空窗 */
.hero__avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background-image: linear-gradient(150deg, var(--glass-bg-strong), var(--c-accent-soft));
  color: var(--c-accent);
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-highlight), 0 8rpx 20rpx rgba(24, 38, 33, 0.08);
}

.hero__text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.hero__greet {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.hero__name {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--c-text);
}

.hero__name--hover {
  opacity: 0.6;
}

.hero__pen {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--c-text-3);
  border-bottom: 2rpx solid var(--c-text-3);
}

.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 首页主视觉：玻璃 + 左上角一层主色雾，避免整块白得发空 */
  background-color: var(--glass-bg);
  background-image:
    linear-gradient(118deg, var(--glass-specular) 0%, rgba(255, 255, 255, 0) 30%),
    radial-gradient(120% 120% at 0% 0%, var(--c-accent-soft) 0%, rgba(0, 0, 0, 0) 58%),
    linear-gradient(158deg, var(--glass-bg-strong) 0%, var(--glass-bg) 66%);
  border: 1rpx solid var(--glass-border);
  border-radius: 28rpx;
  padding: var(--sp-4) var(--sp-3);
  margin-bottom: var(--sp-4);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
}

.stats__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stats__num {
  font-size: var(--fs-display);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--c-text);
}

.stats__label {
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.stats__sep {
  width: 1rpx;
  height: 48rpx;
  background: var(--c-line);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
}

.grid__item {
  width: calc((100% - var(--sp-2) * 3) / 4);
  background-color: var(--glass-bg);
  background-image:
    linear-gradient(118deg, var(--glass-specular) 0%, rgba(255, 255, 255, 0) 34%),
    linear-gradient(158deg, var(--glass-bg-strong) 0%, var(--glass-bg) 70%);
  border: 1rpx solid var(--glass-border);
  border-radius: 22rpx;
  padding: var(--sp-3) var(--sp-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  box-shadow: var(--glass-highlight), 0 6rpx 16rpx rgba(24, 38, 33, 0.04);
  transition: transform 140ms ease, background-color 140ms ease;
}

.grid__item--hover {
  background-color: var(--glass-bg-strong);
  transform: scale(0.96);
}

.grid__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.grid__name {
  font-size: var(--fs-caption);
  color: var(--c-text);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.grid__count {
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.stack-item {
  display: block;
}

.stack-item + .stack-item {
  margin-top: var(--sp-2);
}

.errorbox {
  margin-top: 20vh;
  background-color: var(--glass-bg);
  background-image: linear-gradient(158deg, var(--glass-bg-strong), var(--glass-bg));
  border: 1rpx solid var(--glass-border);
  border-radius: 24rpx;
  padding: var(--sp-5);
  text-align: center;
  box-shadow: var(--glass-shadow), var(--glass-highlight);
}

.errorbox__title {
  display: block;
  font-size: var(--fs-body);
  color: var(--c-danger);
  margin-bottom: var(--sp-3);
}

.errorbox__hint {
  display: block;
  font-size: var(--fs-caption);
  color: var(--c-text-3);
  line-height: 1.6;
}

.errorbox__btn {
  margin-top: var(--sp-5);
  display: inline-block;
  padding: 16rpx 48rpx;
  border: 1rpx solid var(--c-accent);
  border-radius: var(--radius-pill);
  color: var(--c-accent);
  font-size: var(--fs-caption);
}
