.profile {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-5) 0 var(--sp-5);
}

.profile__avatar {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 50%;
  background-image: linear-gradient(150deg, var(--glass-bg-strong), var(--c-accent-soft));
  color: var(--c-accent);
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-highlight), 0 10rpx 24rpx rgba(24, 38, 33, 0.08);
  overflow: hidden;
}

/* 重置 button 默认样式 */
.profile__avatar::after {
  border: none;
}

.profile__avatar-text {
  color: var(--c-accent);
}

/* 绝对定位填满，避免图片固有尺寸撑宽 button（导致椭圆） */
.profile__avatar-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.profile__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.profile__name-input {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--c-text);
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
}

.profile__hint {
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.profile__since {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.summary {
  padding: var(--sp-2) var(--sp-4);
}

.summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.summary__label {
  font-size: var(--fs-body);
  color: var(--c-text-2);
}

.summary__value {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
}

.group {
  margin-top: var(--sp-3);
  background-color: var(--glass-bg);
  background-image:
    linear-gradient(118deg, var(--glass-specular) 0%, rgba(255, 255, 255, 0) 26%),
    linear-gradient(158deg, var(--glass-bg-strong) 0%, var(--glass-bg) 68%);
  border: 1rpx solid var(--glass-border);
  border-radius: 24rpx;
  box-shadow: var(--glass-shadow), var(--glass-highlight), var(--glass-ring);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 var(--sp-4);
}

.row + .row {
  border-top: 1rpx solid var(--c-line);
}

.row--hover {
  background: var(--glass-bg-strong);
}

.row__label {
  font-size: var(--fs-body);
  color: var(--c-text);
}

.row__arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--c-text-3);
  border-bottom: 2rpx solid var(--c-text-3);
  transform: rotate(-45deg);
}

.errorline {
  margin-top: var(--sp-3);
  font-size: var(--fs-caption);
  color: var(--c-danger);
}

.warnbox {
  margin-top: var(--sp-4);
  padding: var(--sp-4);
  border-radius: var(--radius-card);
  background: var(--c-warn-soft);
  border: 1rpx solid var(--c-warn-line);
  color: var(--c-warn-text);
  font-size: var(--fs-caption);
  line-height: 1.6;
}

.footer {
  margin-top: var(--sp-6);
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}
