.profile {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-5) 0 var(--sp-5);
}

.profile__avatar {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 50%;
  
  color: var(--c-accent);
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--glass-border);
  
  overflow: hidden;
}

/* 重置 button 默认样式 */
.profile__avatar::after {
  border: none;
}

.profile__avatar-text {
  color: var(--c-accent);
}

/* 绝对定位填满，避免图片固有尺寸撑宽 button（导致椭圆） */
.profile__avatar-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.profile__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.profile__name-input {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--c-text);
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
}

.profile__hint {
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.profile__since {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.summary {
  padding: var(--sp-2) var(--sp-4);
}

.summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.summary__label {
  font-size: var(--fs-body);
  color: var(--c-text-2);
}

.summary__value {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
}

.group {
  margin-top: var(--sp-3);
  background-color: var(--glass-bg);
  
  border: 1rpx solid var(--glass-border);
  border-radius: 8rpx;
  
  
  
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 var(--sp-4);
}

.row + .row {
  border-top: 1rpx solid var(--c-line);
}

.row--hover {
  background: var(--glass-bg-strong);
}

.row__label {
  font-size: var(--fs-body);
  color: var(--c-text);
}

.row__right {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.row__value {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.row__arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--c-text-3);
  border-bottom: 2rpx solid var(--c-text-3);
  transform: rotate(-45deg);
}

.errorline {
  margin-top: var(--sp-3);
  font-size: var(--fs-caption);
  color: var(--c-danger);
}

.warnbox {
  margin-top: var(--sp-4);
  padding: var(--sp-4);
  border-radius: 8rpx;
  background: var(--c-warn-soft);
  border: 1rpx solid var(--c-warn-line);
  color: var(--c-warn-text);
  font-size: var(--fs-caption);
  line-height: 1.6;
}

.footer {
  /* 固定 tabbar 会盖住页面底部 ~80px，页脚收紧上边距，保证短页面首屏就能完整看到 */
  margin-top: var(--sp-2);
  padding-bottom: var(--sp-4);
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}
