.profile {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-5) 0 var(--sp-5);
}

.profile__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--c-accent-soft);
  color: var(--c-accent);
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile__name {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--c-text);
}

.profile__since {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.summary {
  padding: var(--sp-2) var(--sp-4);
}

.summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.summary__label {
  font-size: var(--fs-body);
  color: var(--c-text-2);
}

.summary__value {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
}

.group {
  margin-top: var(--sp-3);
  background: var(--c-surface);
  border: 1rpx solid var(--c-line);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 var(--sp-4);
}

.row + .row {
  border-top: 1rpx solid var(--c-line);
}

.row--hover {
  background: var(--c-surface-sunken);
}

.row__label {
  font-size: var(--fs-body);
  color: var(--c-text);
}

.row__arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--c-text-3);
  border-bottom: 2rpx solid var(--c-text-3);
  transform: rotate(-45deg);
}

.errorline {
  margin-top: var(--sp-3);
  font-size: var(--fs-caption);
  color: var(--c-danger);
}

.warnbox {
  margin-top: var(--sp-4);
  padding: var(--sp-4);
  border-radius: var(--radius-card);
  background: #fdf6e8;
  border: 1rpx solid #f0e0bd;
  color: #8a6a1f;
  font-size: var(--fs-caption);
  line-height: 1.6;
}

.footer {
  margin-top: var(--sp-6);
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}
