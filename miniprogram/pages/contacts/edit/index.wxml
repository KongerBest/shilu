<view class="page {{themeClass}}">
  <loading wx:if="{{loading}}" mode="block" />

  <empty-state
    wx:elif="{{error}}"
    title="无法编辑"
    desc="{{error}}"
    action-text="返回"
    bind:action="onBack"
  />

  <block wx:else>
    <view class="card">
      <input
        class="title-input"
        value="{{name}}"
        maxlength="24"
        placeholder="姓名"
        placeholder-class="title-placeholder"
        bindinput="onNameInput"
      />
      <text wx:if="{{nameError}}" class="form-error">{{nameError}}</text>

      <view class="form-row">
        <text class="form-label">昵称</text>
        <input
          class="form-input"
          value="{{nickname}}"
          maxlength="24"
          placeholder="选填"
          placeholder-class="form-placeholder"
          bindinput="onNicknameInput"
        />
      </view>
    </view>

    <view class="card">
      <text class="form-label">关系</text>
      <view class="chips">
        <view
          wx:for="{{relationChips}}"
          wx:key="label"
          class="chip {{item.on ? 'is-on' : ''}}"
          data-index="{{index}}"
          bindtap="onRelationTap"
          hover-class="chip--hover"
        >{{item.label}}</view>
      </view>
      <input
        class="form-input form-input--inline"
        value="{{extraRelations}}"
        maxlength="60"
        placeholder="其他关系，用空格或顿号分隔"
        placeholder-class="form-placeholder"
        bindinput="onExtraRelationsInput"
      />
      <text class="form-hint">最多 5 个标签。改了生日会同步自动生成的那条生日纪念日。</text>
    </view>

    <view class="card">
      <view class="form-row">
        <text class="form-label">手机号</text>
        <block wx:if="{{phoneLocked}}">
          <text class="form-locked">已加密 · 解锁后可编辑</text>
          <text class="link" bindtap="onUnlockTap">去解锁</text>
        </block>
        <block wx:else>
          <input
            class="form-input"
            type="text"
            value="{{phone}}"
            maxlength="20"
            placeholder="选填"
            placeholder-class="form-placeholder"
            bindinput="onPhoneInput"
          />
          <text wx:if="{{phone}}" class="link" bindtap="onClearPhone">清除</text>
        </block>
      </view>
      <text wx:if="{{phonePlain}}" class="form-warn">这个号码当前是明文存的，重新填写并解锁保存后会变成密文。</text>
      <text class="form-hint">解锁保险箱后保存的手机号以密文落库，云端看不到明文；锁定时保存只能选明文。</text>
    </view>

    <view class="card">
      <view class="form-row">
        <text class="form-label">生日</text>
        <picker mode="date" value="{{birthday || '2000-01-01'}}" end="{{today}}" bindchange="onBirthdayChange">
          <view class="form-picker">
            <text class="form-picker-text {{birthday ? 'tabular' : 'is-empty'}}">{{birthday || '未填写'}}</text>
            <text class="chevron">›</text>
          </view>
        </picker>
        <text wx:if="{{birthday}}" class="link" bindtap="onClearBirthday">清除</text>
      </view>
      <text class="form-hint">填了生日会自动生成一条每年重复的纪念日，纪念日页就能看到倒计时。</text>
    </view>

    <view class="card">
      <text class="form-label">备注</text>
      <textarea
        class="form-textarea"
        value="{{remark}}"
        maxlength="500"
        placeholder="记点别的：怎么认识的、喜欢什么、下次见面想聊什么"
        placeholder-class="form-placeholder"
        auto-height
        bindinput="onRemarkInput"
      />
    </view>

    <button
      class="btn-primary"
      hover-class="btn-primary--hover"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="onSave"
    >{{saving ? '保存中…' : '保存'}}</button>

    <view class="actions" wx:if="{{isEdit}}">
      <text class="link link--danger" bindtap="onDelete">删除这个人物</text>
    </view>
  </block>
</view>
