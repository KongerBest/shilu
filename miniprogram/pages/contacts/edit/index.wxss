.page {
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--sp-6));
}

.title-input {
  width: 100%;
  height: 88rpx;
  font-size: var(--fs-title);
  font-weight: 500;
  color: var(--c-text);
}

.title-placeholder {
  color: var(--c-text-3);
  font-weight: 400;
}

/* 自定义关系：贴在 chips 下面，左对齐而不是右对齐 */
.form-input--inline {
  width: 100%;
  margin-left: 0;
  margin-top: var(--sp-3);
  padding: 16rpx var(--sp-3);
  text-align: left;
  font-size: var(--fs-body);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-control);
  background: var(--glass-bg-soft);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: var(--sp-3);
  padding: var(--sp-3);
  box-sizing: border-box;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--c-text);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-control);
  background: var(--glass-bg-soft);
}

.form-locked {
  flex: 1;
  margin-left: var(--sp-4);
  text-align: right;
  font-size: var(--fs-body);
  color: var(--c-text-3);
}

.form-warn {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-micro);
  line-height: 1.5;
  color: var(--c-warn);
}

.actions {
  display: flex;
  justify-content: center;
  margin-top: var(--sp-5);
}
