.toolbar {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin-bottom: var(--sp-4);
}

.chips {
  display: flex;
  gap: var(--sp-2);
}

.chip {
  padding: 10rpx 28rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--c-line);
  background: var(--c-surface);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.chip.is-active {
  background: var(--c-accent-soft);
  border-color: var(--c-accent);
  color: var(--c-accent);
}

.stack-item {
  display: block;
}

.stack-item + .stack-item {
  margin-top: var(--sp-2);
}

.listend {
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
  padding: var(--sp-5) 0;
}

/* 悬浮新增：在 tabbar 之上留出空间 */
.fab {
  position: fixed;
  right: var(--sp-4);
  bottom: calc(var(--tabbar-height) + var(--sp-4) + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--c-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(47, 93, 80, 0.28);
  z-index: 90;
}

.fab--hover {
  opacity: 0.85;
}

.fab__h,
.fab__v {
  position: absolute;
  background: #ffffff;
  border-radius: 2rpx;
}

.fab__h {
  width: 32rpx;
  height: 3rpx;
}

.fab__v {
  width: 3rpx;
  height: 32rpx;
}

.errorbox {
  margin-top: 16vh;
  background: var(--c-surface);
  border: 1rpx solid var(--c-line);
  border-radius: var(--radius-card);
  padding: var(--sp-5);
  text-align: center;
}

.errorbox__title {
  display: block;
  font-size: var(--fs-body);
  color: var(--c-danger);
}

.errorbox__btn {
  margin-top: var(--sp-4);
  display: inline-block;
  padding: 16rpx 48rpx;
  border: 1rpx solid var(--c-accent);
  border-radius: var(--radius-pill);
  color: var(--c-accent);
  font-size: var(--fs-caption);
}

/* 分类横向筛选条 */
.cat-chips {
  display: flex;
  white-space: nowrap;
}

.chip--cat {
  flex-shrink: 0;
  margin-right: var(--sp-2);
}
