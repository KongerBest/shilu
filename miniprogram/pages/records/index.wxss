.toolbar {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin-bottom: var(--sp-4);
}

.chips {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

/* 固定高度 + 行内居中：此前只写 padding，高度跟着 line-height 走，
   且 scroll-view 里的 chip 会被拉伸成高矮不一的方块 */
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: var(--h-chip);
  padding: 0 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--glass-border);
  background-color: var(--glass-bg-soft);
  
  font-size: var(--fs-caption);
  line-height: 1;
  color: var(--c-text-2);
  flex-shrink: 0;
  
  transition: transform 120ms ease, background-color 120ms ease, border-color 120ms ease, color 120ms ease;
}

/* 选中态 = 文章所说「切换态高透玻璃」：主色淡染高透背景 + 主色描边 + 主色文字，
   而不是实心主色，让环境光能透过来 */
.chip.is-active {
  background-color: var(--c-accent-glass-soft);
  
  border-color: var(--c-accent);
  color: var(--c-accent);
  font-weight: 600;
  
}

.stack-item {
  display: block;
}

.stack-item + .stack-item {
  margin-top: var(--sp-2);
}

.listend {
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
  padding: var(--sp-5) 0;
}

/* 悬浮新增：在 tabbar 之上留出空间；右侧与页面留白对齐 */
.fab {
  position: fixed;
  right: var(--page-gutter);
  bottom: calc(var(--tabbar-height) + var(--sp-4) + env(safe-area-inset-bottom) + 12rpx);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--c-accent);
  
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--glass-border-soft);
  
  transition: transform 140ms ease;
  z-index: 90;
}

.fab--hover {
  transform: scale(0.94);
}

.fab__h,
.fab__v {
  position: absolute;
  background: var(--c-fab-fg);
  border-radius: 8rpx;
}

.fab__h {
  width: 32rpx;
  height: 3rpx;
}

.fab__v {
  width: 3rpx;
  height: 32rpx;
}

.errorbox {
  margin-top: 16vh;
  background-color: var(--glass-bg);
  
  border: 1rpx solid var(--glass-border);
  border-radius: 8rpx;
  padding: var(--sp-5);
  text-align: center;
  
}

.errorbox__title {
  display: block;
  font-size: var(--fs-body);
  color: var(--c-danger);
}

.errorbox__btn {
  margin-top: var(--sp-4);
  display: inline-block;
  padding: 16rpx 48rpx;
  border: 1rpx solid var(--c-accent);
  border-radius: 8rpx;
  color: var(--c-accent);
  font-size: var(--fs-caption);
}

/* 分类横向筛选条。
   scroll-view 内部走行内布局时，inline-flex 的 chip 会按基线对齐被顶出容器（顶部被裁），
   所以里面再包一层 flex 轨道，让 chip 变成普通 flex item。 */
.cat-chips {
  white-space: nowrap;
}

.cat-track {
  display: flex;
  align-items: center;
  padding: 2rpx;
}

.chip--cat {
  flex-shrink: 0;
  margin-right: var(--sp-2);
}

.chip--cat:last-child {
  margin-right: 0;
}
