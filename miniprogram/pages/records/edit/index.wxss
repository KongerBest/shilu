.title-input {
  width: 100%;
  height: 88rpx;
  font-size: var(--fs-title);
  font-weight: 500;
  color: var(--c-text);
}

.title-placeholder {
  color: var(--c-text-3);
  font-weight: 400;
}

.record-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-5);
  padding: 0 var(--sp-1);
}

.link--danger {
  color: var(--c-danger);
}

/* 敏感字段加密提示：低饱和玻璃条，不抢表单主体 */
.crypto-note {
  margin-top: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-control);
  background-color: var(--glass-bg-soft);
  
  
}

.crypto-note--hover {
  background-color: var(--glass-bg-strong);
}

.crypto-note__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.crypto-note__title {
  font-size: var(--fs-body);
  color: var(--c-text);
}

.crypto-note__cta {
  font-size: var(--fs-caption);
  color: var(--c-accent);
}

.crypto-note__desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  line-height: 1.55;
  color: var(--c-text-3);
}

/* 关联人物：摘要靠右，过长省略，操作链接固定不被挤走 */
.contact-pick {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-left: var(--sp-4);
}

.contact-pick__summary {
  max-width: 340rpx;
  font-size: var(--fs-body);
  color: var(--c-text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-pick .link {
  flex-shrink: 0;
  margin-left: var(--sp-2);
}
