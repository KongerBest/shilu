<view class="page {{themeClass}}" data-weui-theme="{{themeMode || 'light'}}">
  <loading wx:if="{{loading}}" mode="block" />
  <empty-state
    wx:elif="{{locked}}"
    title="保险箱已锁定"
    desc="这条资料含加密字段，解锁后才能查看与编辑。"
    action-text="去解锁"
    bind:action="onUnlockTap"
  />
  <empty-state
    wx:elif="{{error}}"
    title="加载失败"
    desc="{{error}}"
    action-text="重试"
    bind:action="onRetry"
  />
  <block wx:else>
    <view class="card">
      <input
        class="title-input"
        value="{{title}}"
        maxlength="100"
        placeholder="给它一个标题"
        placeholder-class="title-placeholder"
        bindinput="onTitleInput"
      />
      <text wx:if="{{titleError}}" class="form-error">{{titleError}}</text>
    </view>

    <view class="card">
      <view class="form-row weui-cell">
        <text class="form-label">分类</text>
        <picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="form-picker">
            <text class="form-picker-text">{{categoryNames[categoryIndex]}}</text>
            <text class="chevron">›</text>
          </view>
        </picker>
      </view>
      <view class="form-row weui-cell">
        <text class="form-label">表单模板</text>
        <picker range="{{templateOptions}}" value="{{templateIndex}}" bindchange="onTemplateChange">
          <view class="form-picker">
            <text class="form-picker-text">{{templateOptions[templateIndex]}}</text>
            <text class="chevron">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="card" wx:if="{{hasTemplate}}">
      <field-renderer
        wx:for="{{fieldViews}}"
        wx:key="key"
        field="{{item.field}}"
        value="{{item.value}}"
        error="{{item.error}}"
        bind:change="onFieldChange"
      />
    </view>

    <view class="card" wx:else>
      <text class="muted">当前没有使用模板，只能保存标题。</text>
      <text class="form-hint">
        到「我的 → 分类管理」给这个分类选一个默认模板，或者在上面把表单模板换成别的。
      </text>
    </view>

    <view class="card">
      <view class="form-row weui-cell">
        <text class="form-label">关联人物</text>
        <view class="contact-pick">
          <text class="contact-pick__summary">{{contactSummary}}</text>
          <text wx:if="{{contacts.length > 0}}" class="link" bindtap="onToggleContactPicker">{{showContactPicker ? '收起' : '选择'}}</text>
          <text wx:else class="link" bindtap="onCreateContact">新建人物</text>
        </view>
      </view>
      <view class="chips" wx:if="{{showContactPicker}}">
        <view
          wx:for="{{contacts}}"
          wx:key="_id"
          class="chip {{item.on ? 'is-on' : ''}}"
          data-index="{{index}}"
          bindtap="onContactToggle"
          hover-class="chip--hover"
        >{{item.name}}</view>
      </view>
    </view>

    <view wx:if="{{hasSensitiveFields}}" class="crypto-note" bindtap="onUnlockTap" hover-class="crypto-note--hover">
      <view class="crypto-note__head">
        <text class="crypto-note__title">{{vaultUnlocked ? '敏感字段将以密文保存' : '敏感字段尚未加密'}}</text>
        <text wx:if="{{!vaultUnlocked}}" class="crypto-note__cta">去解锁</text>
      </view>
      <text class="crypto-note__desc">
        {{vaultUnlocked ? '主密码只在本地派生密钥，云端只存密文；忘记密码且丢失恢复码将无法找回。' : '保险箱未解锁，保存时还会再确认一次；未解锁写入的是明文。'}}
      </text>
    </view>

    <button class="btn-primary weui-btn weui-btn_primary" hover-class="btn-primary--hover" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">
      {{saving ? '保存中…' : '保存'}}
    </button>

    <view class="record-actions" wx:if="{{isEdit}}">
      <text class="link" bindtap="onArchiveToggle">{{isArchived ? '取消归档' : '归档'}}</text>
      <text class="link link--danger" bindtap="onDelete">删除这条资料</text>
    </view>
  </block>
</view>
