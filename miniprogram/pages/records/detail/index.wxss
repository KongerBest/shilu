.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.detail-title {
  flex: 1;
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.35;
  color: var(--c-text);
}

.detail-meta {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.detail-times {
  display: flex;
  margin-top: 4rpx;
}

.detail-time {
  margin-right: var(--sp-3);
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.detail-rows-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--c-line);
}

.detail-row {
  display: flex;
  /* 垂直居中：小程序 text 组件对 baseline 对齐不可靠，改用 center 让标签与值的盒子中心对齐；
     配合下方统一的 line-height，两列文字的中心线严格重合 */
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--c-line);
}

.detail-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.detail-label {
  flex-shrink: 0;
  width: 180rpx;
  font-size: var(--fs-caption);
  /* 与值统一行高：值 28rpx×1.5=42rpx，标签也用 42rpx，两列文字中心严格在同一水平线 */
  line-height: 42rpx;
  height: 42rpx;
  color: var(--c-text-3);
}

.detail-value {
  flex: 1;
  font-size: var(--fs-body);
  line-height: 42rpx;
  color: var(--c-text);
  word-break: break-all;
}

.detail-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-5);
  padding: 0 var(--sp-1);
}

.link--danger {
  color: var(--c-danger);
}

/* 附件区标题：与字段卡片的分隔头保持一致的视觉节奏 */
.attach-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--c-line);
}

.attach-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
}
