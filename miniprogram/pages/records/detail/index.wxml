<view class="page {{themeClass}}" data-weui-theme="{{themeMode || 'light'}}">
  <loading wx:if="{{loading}}" mode="block" />
  <empty-state
    wx:elif="{{error}}"
    title="加载失败"
    desc="{{error}}"
    action-text="重试"
    bind:action="onRetry"
  />
  <block wx:else>
    <view class="card">
      <view class="detail-head">
        <text class="detail-title">{{title}}</text>
        <text wx:if="{{isArchived}}" class="tag weui-badge tag--warn">已归档</text>
      </view>
      <text class="detail-meta">{{metaText}}</text>
      <view class="detail-times">
        <text class="detail-time">创建 {{createdText}}</text>
        <text class="detail-time">更新 {{updatedText}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{rows.length > 0}}">
      <view class="detail-rows-head" wx:if="{{hasSensitive || encryptedCount > 0}}">
        <text class="form-hint">{{encryptedCount > 0 ? '含加密字段，解锁后可见' : '含敏感字段，默认掩码显示'}}</text>
        <text class="link" bindtap="onToggleReveal">{{encryptedCount > 0 ? '去解锁' : revealSensitive ? '隐藏' : '显示'}}</text>
      </view>
      <view wx:for="{{rows}}" wx:key="key" class="detail-row weui-cell" data-key="{{item.key}}" bindtap="onRowTap">
        <view class="detail-label">{{item.label}}<text wx:if="{{item.sensitive}}" class="tag weui-badge tag--warn">{{item.encrypted ? '加密' : '敏感'}}</text></view>
        <view class="detail-value {{item.encrypted ? 'detail-value--locked' : ''}}"><block wx:if="{{item.encrypted}}">{{item.text}}</block><block wx:elif="{{revealSensitive || !item.sensitive}}">{{item.raw}}</block><block wx:else>{{item.text}}</block></view>
      </view>
    </view>

    <view class="card" wx:elif="{{attachmentFields.length === 0}}">
      <text class="muted">这条资料还没有填写内容。</text>
    </view>

    <!-- 模板里的图片 / 文件字段：只读上传器，按字段 key 取附件 -->
    <view class="card" wx:for="{{attachmentFields}}" wx:key="key">
      <view class="attach-head">
        <text class="attach-title">{{item.label}}</text>
        <text class="form-hint">{{item.hint}}</text>
      </view>
      <file-uploader
        biz-type="record"
        biz-id="{{id}}"
        field-key="{{item.key}}"
        role="{{item.role}}"
        accept="{{item.accept}}"
        max="{{item.max}}"
        readonly
        encrypt="{{encryptedAttachments}}"
      />
    </view>

    <block wx:if="{{isDocument}}">
      <view class="card">
        <view class="attach-head">
          <text class="attach-title">证件正面</text>
          <text class="form-hint">加密存储 · 云端仅存密文</text>
        </view>
        <file-uploader
          biz-type="record"
          biz-id="{{id}}"
          role="front"
          accept="image"
          max="1"
          encrypt="{{encryptedAttachments}}"
        />
      </view>

      <view class="card">
        <view class="attach-head">
          <text class="attach-title">证件反面</text>
          <text class="form-hint">加密存储 · 云端仅存密文</text>
        </view>
        <file-uploader
          biz-type="record"
          biz-id="{{id}}"
          role="back"
          accept="image"
          max="1"
          encrypt="{{encryptedAttachments}}"
        />
      </view>

      <view class="card">
        <view class="attach-head">
          <text class="attach-title">其他图片</text>
          <text class="form-hint">最多 9 张，单张 20MB</text>
        </view>
        <file-uploader
          biz-type="record"
          biz-id="{{id}}"
          role="other"
          accept="image"
          max="9"
          encrypt="{{encryptedAttachments}}"
        />
      </view>
    </block>

    <block wx:else>
      <view class="card">
        <view class="attach-head">
          <text class="attach-title">图片</text>
          <text class="form-hint">最多 9 张，单张 20MB</text>
        </view>
        <file-uploader
          biz-type="record"
          biz-id="{{id}}"
          role="other"
          accept="image"
          max="9"
          encrypt="{{encryptedAttachments}}"
        />
      </view>

      <view class="card">
        <view class="attach-head">
          <text class="attach-title">文件</text>
          <text class="form-hint">PDF / 文档，最多 5 个</text>
        </view>
        <file-uploader
          biz-type="record"
          biz-id="{{id}}"
          role="file"
          accept="file"
          max="5"
          encrypt="{{encryptedAttachments}}"
        />
      </view>
    </block>

    <view class="card" wx:if="{{contacts.length > 0}}">
      <text class="form-hint">关联人物</text>
      <view class="contact-links">
        <text
          wx:for="{{contacts}}"
          wx:key="_id"
          class="contact-link"
          data-id="{{item._id}}"
          bindtap="onContactTap"
          hover-class="contact-link--hover"
        >{{item.name}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{hasSensitive}}">
      <text class="form-hint">
        敏感字段不会进入搜索索引与列表摘要，详情页默认掩码。保险箱解锁后新保存的敏感字段以密文存云端；
        早于该版本保存的记录尚未回填，可能仍是明文。
      </text>
    </view>

    <button class="btn-primary weui-btn weui-btn_primary" hover-class="btn-primary--hover" bindtap="onEditTap">编辑</button>

    <view class="detail-actions">
      <text class="link" bindtap="onFavoriteTap">{{isFavorite ? '取消收藏' : '收藏'}}</text>
      <text class="link link--danger" bindtap="onDeleteTap">删除</text>
    </view>
  </block>
</view>
