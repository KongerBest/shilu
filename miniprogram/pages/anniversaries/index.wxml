<page-meta
  background-color="{{themeBg}}"
  background-text-style="{{themeBgText}}"
  root-background-color="{{themeBg}}"
  page-style="background-color:{{themeBg}};"
></page-meta>
<!-- 单条纪念日：列表与日历共用一套结构，避免两处改样式时漏掉一边 -->
<template name="anniversaryRow">
  <view class="arow weui-cell weui-cell_access" data-id="{{_id}}" bindtap="onItemTap" hover-class="arow--hover">
    <view class="arow__bar" style="background: {{accent}}"></view>
    <view class="arow__main">
      <view class="arow__head">
        <text class="arow__title">{{title}}</text>
        <text class="arow__count">{{countdown}}</text>
      </view>
      <view class="arow__meta">
        <text class="tag weui-badge tag--accent">{{typeLabel}}</text>
        <text class="arow__meta-text">{{nextText}} · {{repeatLabel}}</text>
      </view>
    </view>
    <text class="weui-arrow">›</text>
  </view>
</template>

<view class="page {{themeClass}}" data-weui-theme="{{themeMode || 'light'}}">
  <nav-bar title="纪念日" />
  <loading wx:if="{{loading}}" mode="block" text="正在读取" />
  <empty-state
    wx:elif="{{error}}"
    title="加载失败"
    desc="{{error}}"
    action-text="重试"
    bind:action="onRetry"
  />
  <block wx:else>
    <view class="card hero" wx:if="{{nextTitle}}">
      <text class="hero__kicker">下一个纪念日</text>
      <view class="hero__main">
        <text class="hero__title">{{nextTitle}}</text>
        <text class="hero__count">{{nextCountdown}}</text>
      </view>
      <text class="hero__meta">{{nextDateText}}</text>
    </view>

    <view class="stats">
      <view class="stats__item">
        <text class="stats__value tabular">{{monthCount}}</text>
        <text class="stats__label">本月</text>
      </view>
      <view class="stats__divider"></view>
      <view class="stats__item">
        <text class="stats__value tabular">{{total}}</text>
        <text class="stats__label">全部</text>
      </view>
      <view class="stats__divider"></view>
      <view class="stats__item">
        <text class="stats__value stats__value--date tabular">{{today}}</text>
        <text class="stats__label">今天</text>
      </view>
    </view>

    <view class="card reminder">
      <view class="reminder__main">
        <text class="reminder__title">提醒额度</text>
        <text wx:if="{{!reminderConfigured}}" class="reminder__desc">当前构建未配置订阅消息模板，到点不会推送</text>
        <text wx:elif="{{reminderQuota > 0}}" class="reminder__desc">剩 {{reminderQuota}} 次 · 一次授权一条，用完需再授权</text>
        <text wx:else class="reminder__desc">还没有额度 · 授权后才会推送</text>
        <text wx:if="{{nextFireText}}" class="reminder__meta">下次提醒 {{nextFireText}}</text>
      </view>
      <view
        wx:if="{{reminderConfigured}}"
        class="reminder__btn {{granting ? 'is-busy' : ''}}"
        bindtap="onGrantReminder"
        hover-class="reminder__btn--hover"
      >{{granting ? '授权中' : '授权 1 次'}}</view>
    </view>

    <view class="view-switch weui-navbar" wx:if="{{items.length > 0}}">
      <view
        class="view-switch__item weui-navbar__item {{view === 'list' ? 'weui-bar__item_on' : ''}}"
        data-view="list"
        bindtap="onViewChange"
      >列表</view>
      <view
        class="view-switch__item weui-navbar__item {{view === 'calendar' ? 'weui-bar__item_on' : ''}}"
        data-view="calendar"
        bindtap="onViewChange"
      >日历</view>
    </view>

    <block wx:if="{{items.length > 0 && view === 'calendar'}}">
      <view class="card cal">
        <view class="cal__head">
          <view class="cal__nav" data-delta="-1" bindtap="onMonthShift" hover-class="cal__nav--hover">‹</view>
          <text class="cal__title">{{monthText}}</text>
          <view class="cal__nav" data-delta="1" bindtap="onMonthShift" hover-class="cal__nav--hover">›</view>
        </view>

        <view class="cal-week">
          <text wx:for="{{weekdays}}" wx:key="*this" class="cal-week__item">{{item}}</text>
        </view>

        <view class="cal-grid">
          <view
            wx:for="{{cells}}"
            wx:key="date"
            class="cal-cell {{item.inMonth ? '' : 'is-out'}} {{item.isToday ? 'is-today' : ''}} {{item.date === selectedDate ? 'is-selected' : ''}}"
            data-date="{{item.date}}"
            bindtap="onDayTap"
          >
            <text class="cal-cell__day tabular">{{item.day}}</text>
            <view class="cal-cell__dot" wx:if="{{item.count > 0}}"></view>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section__head">
          <text class="section__title weui-cells__title">{{selectedLabel}}</text>
          <text class="section__action" wx:if="{{!isCurrentMonth}}" bindtap="onBackToday">回到今天</text>
        </view>

        <view class="card list" wx:if="{{selectedItems.length > 0}}">
          <block wx:for="{{selectedItems}}" wx:key="_id">
            <template is="anniversaryRow" data="{{...item}}" />
          </block>
        </view>
        <text class="cal-hint" wx:else>{{selectedDate ? '这一天没有纪念日' : '这个月没有纪念日'}}</text>
      </view>
    </block>

    <view class="section" wx:elif="{{items.length > 0}}">
      <view class="section__head">
        <text class="section__title weui-cells__title">全部纪念日</text>
        <text class="section__action">按临近排序</text>
      </view>

      <view class="card list">
        <block wx:for="{{items}}" wx:key="_id">
          <template is="anniversaryRow" data="{{...item}}" />
        </block>
      </view>
    </view>

    <empty-state
      wx:else
      title="还没有纪念日"
      desc="生日、相遇、毕业、任何一个想记住的日子，都可以放进来倒数。"
      action-text="新建纪念日"
      bind:action="onCreateTap"
    />

    <button
      wx:if="{{items.length > 0}}"
      class="btn-primary weui-btn weui-btn_primary"
      hover-class="btn-primary--hover"
      bindtap="onCreateTap"
    >新建纪念日</button>
  </block>

  <custom-tabbar id="tabbar" current="anniversaries" />
</view>
