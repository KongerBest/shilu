.page {
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + var(--sp-6));
}

/* 下一个纪念日：玻璃主卡，倒计时是视觉重心 */
.hero {
  margin-top: var(--sp-3);
  padding: var(--sp-5);
  
  border: 1rpx solid var(--glass-border);
  
  overflow: hidden;
}

.hero__kicker {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
  letter-spacing: 0.04em;
}

.hero__main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: var(--sp-2);
}

.hero__title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero__count {
  flex-shrink: 0;
  margin-left: var(--sp-3);
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-accent);
}

.hero__meta {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

/* 三项统计：与首页统计卡同构 */
.stats {
  display: flex;
  align-items: center;
  margin-top: var(--sp-3);
  padding: var(--sp-4) 0;
  border: 1rpx solid var(--glass-border);
  border-radius: 8rpx;
  background-color: var(--glass-bg-soft);
  
  
}

.stats__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stats__value {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
}

/* 日期比数字长，降到正文级避免折行 */
.stats__value--date {
  font-size: var(--fs-body);
  white-space: nowrap;
}

.stats__label {
  font-size: var(--fs-caption);
  color: var(--c-text-3);
}

.stats__divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--c-line);
}

.list {
  padding: 0;
}

/* 全局 .section 只有 margin-bottom，这里紧跟在统计卡后，需要补上间距 */
.section {
  margin-top: var(--sp-5);
}

.arow {
  display: flex;
  align-items: center;
  padding: var(--sp-3) var(--sp-4);
  transition: background-color 140ms ease;
}

.arow + .arow {
  border-top: 1rpx solid var(--c-line);
}

.arow--hover {
  background: var(--glass-bg-strong);
}

.arow__bar {
  flex-shrink: 0;
  width: 6rpx;
  height: 56rpx;
  border-radius: 8rpx;
  margin-right: var(--sp-3);
}

.arow__main {
  flex: 1;
  min-width: 0;
}

.arow__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.arow__title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arow__count {
  flex-shrink: 0;
  margin-left: var(--sp-2);
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--c-accent);
}

.arow__meta {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: 8rpx;
}

.arow__meta-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--c-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arow .chevron {
  margin-left: var(--sp-2);
}

/* 提醒额度：一行说清还剩几条，右侧只给一个动作 */
.reminder {
  display: flex;
  align-items: center;
  margin-top: var(--sp-3);
  padding: var(--sp-4);
}

.reminder__main {
  flex: 1;
  min-width: 0;
}

.reminder__title {
  display: block;
  font-size: var(--fs-body);
  color: var(--c-text);
}

.reminder__desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  line-height: 1.5;
  color: var(--c-text-3);
}

.reminder__meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.reminder__btn {
  flex-shrink: 0;
  margin-left: var(--sp-3);
  padding: 14rpx 24rpx;
  font-size: var(--fs-caption);
  color: var(--c-accent);
  border: 1rpx solid var(--c-accent);
  border-radius: 999rpx;
  background: var(--c-accent-glass-soft);
}

.reminder__btn--hover {
  background: var(--c-accent-soft);
}

.reminder__btn.is-busy {
  color: var(--c-text-3);
  border-color: var(--glass-border);
  background: var(--glass-bg-soft);
}

/* 视图切换：列表 / 日历 */
/* 列表 / 日历切换：改用 WEUI Navbar 平面样式，去掉自定义胶囊分段控件 */
.view-switch.weui-navbar {
  display: flex;
  margin: 32rpx 0 0;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid var(--weui-FG-3);
  border-radius: 0;
  background-color: var(--weui-BG-2);
}

.view-switch__item.weui-navbar__item {
  flex: 1;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 400;
  color: var(--weui-FG-1);
  text-align: center;
  border-radius: 0;
  background: transparent;
}

.view-switch__item.weui-navbar__item.weui-bar__item_on {
  color: var(--weui-BRAND);
  font-weight: 500;
  background-color: var(--weui-BG-2);
  border-bottom: 4rpx solid var(--weui-BRAND);
}

/* 月历：6 行固定高度，换月不跳动 */
.cal {
  margin-top: var(--sp-3);
  padding: var(--sp-3) var(--sp-2) var(--sp-2);
}

.cal__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--sp-2) var(--sp-1);
}

.cal__title {
  flex: 1;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-text);
  text-align: center;
}

.cal__nav {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  font-size: 34rpx;
  line-height: 60rpx;
  color: var(--c-text-2);
  text-align: center;
  border-radius: 50%;
}

.cal__nav--hover {
  background: var(--glass-bg-strong);
}

.cal-week {
  display: flex;
  padding-bottom: var(--sp-1);
}

.cal-week__item {
  width: 14.2857%;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
  text-align: center;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 14.2857%;
  height: 84rpx;
  padding-top: 6rpx;
}

.cal-cell__day {
  width: 56rpx;
  height: 56rpx;
  font-size: var(--fs-body);
  line-height: 56rpx;
  color: var(--c-text);
  text-align: center;
  border-radius: 50%;
}

.cal-cell.is-out .cal-cell__day {
  color: var(--c-text-3);
  opacity: 0.35;
}

.cal-cell.is-today .cal-cell__day {
  color: var(--c-accent);
  font-weight: 600;
  background: var(--c-accent-soft);
}

/* 选中态放在今天之后：同一天被选中时以填色为准 */
.cal-cell.is-selected .cal-cell__day {
  color: var(--c-on-accent);
  font-weight: 600;
  background: var(--c-accent);
}

.cal-cell__dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: var(--c-accent);
}

.cal-cell.is-selected .cal-cell__dot {
  background: var(--c-accent-deep);
}

.cal-hint {
  display: block;
  padding: var(--sp-5) 0;
  font-size: var(--fs-caption);
  color: var(--c-text-3);
  text-align: center;
}

