<page-meta
  background-color="{{themeBg}}"
  background-text-style="{{themeBgText}}"
  root-background-color="{{themeBg}}"
  page-style="background-color:{{themeBg}};"
></page-meta>
<view class="page page--plain {{themeClass}}" data-weui-theme="{{themeMode || 'light'}}">
  <view class="card doc weui-article">
    <text class="doc__title">{{title}}</text>
    <text class="doc__date">最近更新：{{updatedAt}}</text>
    <text class="doc__intro">{{intro}}</text>

    <view wx:for="{{sections}}" wx:key="title" wx:for-index="sIdx" class="clause">
      <text class="clause__title">{{sIdx + 1}}. {{item.title}}</text>
      <text
        wx:for="{{item.paragraphs}}"
        wx:for-item="para"
        wx:key="*this"
        class="clause__p"
      >{{para}}</text>
    </view>

    <text class="doc__foot">{{footer}}</text>
  </view>
</view>
