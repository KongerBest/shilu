/**
 * WEUI 设计令牌映射层。
 *
 * 视觉真值来源：styles/weui.wxss（Tencent weui-wxss v2.5.0，官方发布版）。
 * 本文件不再定义任何自有色板/玻璃材质，只把旧业务语义变量映射到 WEUI 官方变量，
 * 使尚未改名完成的旧样式也自动获得 WEUI 的配色、层级与暗色主题表现。
 *
 * 主题机制：
 * - light：weui.wxss 在 page / [data-weui-theme=light] 上定义 --weui-* 浅色值
 * - dark ：根节点带 data-weui-theme="dark"，weui.wxss 的 [data-weui-theme=dark]
 *          覆盖同名变量；本文件用「选择器并列」让别名在该节点上重新解析，
 *          避免 CSS 变量在 page 上被提前求值成浅色后无法跟随主题切换。
 */
page,
[data-weui-theme='dark'] {
  /* 语义色：全部指向 WEUI 官方变量 */
  --c-bg: var(--weui-BG-0);
  --c-surface: var(--weui-BG-2);
  --c-surface-sunken: var(--weui-BG-1);
  --c-text: var(--weui-FG-0);
  --c-text-2: var(--weui-FG-1);
  --c-text-3: var(--weui-FG-2);
  --c-line: var(--weui-FG-3);
  --c-accent: var(--weui-BRAND);
  --c-accent-soft: var(--weui-TAG-BACKGROUND-GREEN);
  --c-danger: var(--weui-RED);
  --c-warn: var(--weui-ORANGE);
  --c-warn-soft: var(--weui-TAG-BACKGROUND-ORANGE);
  --c-warn-line: var(--weui-FG-3);
  --c-warn-text: var(--weui-TAG-TEXT-ORANGE);

  --c-tabbar-bg: var(--weui-BG-1);
  --c-fab-fg: #ffffff;
  --c-knob: #ffffff;
  --c-shadow-card: none;
  --c-shadow-fab: none;

  --c-accent-deep: var(--weui-TEXTGREEN);
  --c-accent-bright: var(--weui-BRAND);
  --c-on-accent: #ffffff;
  --shadow-accent: none;

  /* 旧玻璃材质变量：一律中性化，彻底移除渐变 / 折射 / 磨砂 */
  --glow-1: transparent;
  --glow-2: transparent;
  --glow-3: transparent;
  --bg-gradient: none;
  --glass-bg: var(--weui-BG-2);
  --glass-bg-strong: var(--weui-BG-2);
  --glass-bg-soft: var(--weui-BG-1);
  --glass-border: var(--weui-FG-3);
  --glass-border-soft: var(--weui-FG-3);
  --glass-highlight: none;
  --glass-ring: none;
  --glass-shadow: none;
  --glass-shadow-lg: none;
  --glass-specular: transparent;
  --glass-blur: none;
  --c-accent-glass: var(--weui-BRAND);
  --c-accent-glass-bright: var(--weui-BRAND);
  --c-accent-glass-soft: var(--weui-TAG-BACKGROUND-GREEN);
  --shadow-float: none;
  --glass-tabbar: var(--weui-BG-1);

  /* 动效：WEUI 只用短促的状态反馈，不做整页转场 */
  --dur-fast: 120ms;
  --dur-base: 200ms;
  --ease-out: ease-out;

  /* 字排：贴近 WEUI 17px 正文 / 14px 辅助文 */
  --font-sans: -apple-system-font, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --font-mono: 'SF Mono', Menlo, Consolas, monospace;
  --fs-display: 48rpx;
  --fs-h1: 40rpx;
  --fs-title: 34rpx;
  --fs-body: 32rpx;
  --fs-caption: 28rpx;
  --fs-micro: 24rpx;
  --lh-body: 1.6;

  /* 页面水平留白：唯一来源。
     24rpx（12px）让白块离屏边有一指宽的空隙，同时白块内部仍是 WEUI 的 32rpx，
     于是「卡片边缘 24rpx / 卡片内文字 56rpx」在全站保持一致。
     页面不要自己再写左右 padding，否则内外边距会叠加。 */
  --page-gutter: 24rpx;

  /* 宽屏最大内容宽度。超出后整页居中留白，避免平板 / PC 上被拉成一条。 */
  --page-max: 100%;

  /* 间距：8 的倍数，主内边距对齐 WEUI 的 16px */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 16rpx;
  --sp-4: 32rpx;
  --sp-5: 32rpx;
  --sp-6: 48rpx;
  --sp-7: 64rpx;

  /* WEUI 列表/表单容器不圆角，弹层 12px */
  --radius-sm: 8rpx;
  --radius-card: 0rpx;
  --radius-sheet: 24rpx;
  --radius-pill: 999rpx;

  --h-control: 88rpx;
  --h-chip: 56rpx;
  /* WEUI Tabbar 含图标、文字与安全区留白，实测约 80px；页面底部据此预留，
     否则 .weui-footer 一类尾部内容会被固定 tabbar 盖住。 */
  --tabbar-height: 160rpx;

  /* 滚动边界氛围已随玻璃层移除；原生导航栏统一用 WEUI 平面色 */
  --edge-top-tint: transparent;
  --edge-bottom-tint: transparent;
  --edge-specular: transparent;
  --edge-glass: transparent;
  --nav-top: #f7f7f7;
  --nav-mid: #f7f7f7;
  --nav-bottom: #f7f7f7;
}

/** 深色下三层底色跟随 WEUI 暗色板，且导航栏不再做渐变三态切换 */
[data-weui-theme='dark'] {
  --nav-top: #1e1e1e;
  --nav-mid: #1e1e1e;
  --nav-bottom: #1e1e1e;
}
