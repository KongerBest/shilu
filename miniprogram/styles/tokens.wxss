/**
 * WEUI 设计令牌映射层。
 *
 * 视觉真值来源：styles/weui.wxss（Tencent weui-wxss v2.5.0，官方发布版）。
 * 本文件不再定义任何自有色板/玻璃材质，只把旧业务语义变量映射到 WEUI 官方变量，
 * 使尚未改名完成的旧样式也自动获得 WEUI 的配色、层级与暗色主题表现。
 *
 * 主题机制：
 * - light：weui.wxss 在 page / [data-weui-theme=light] 上定义 --weui-* 浅色值
 * - dark ：根节点带 data-weui-theme="dark"，weui.wxss 的 [data-weui-theme=dark]
 *          覆盖同名变量；本文件用「选择器并列」让别名在该节点上重新解析，
 *          避免 CSS 变量在 page 上被提前求值成浅色后无法跟随主题切换。
 */
page,
[data-weui-theme='dark'] {
  /* 语义色：全部指向 WEUI 官方变量 */
  --c-bg: var(--weui-BG-0);
  --c-surface: var(--weui-BG-2);
  --c-surface-sunken: var(--weui-BG-1);
  --c-text: var(--weui-FG-0);
  --c-text-2: var(--weui-FG-1);
  --c-text-3: var(--weui-FG-2);
  --c-line: var(--weui-FG-3);
  --c-accent: var(--weui-BRAND);
  --c-accent-soft: var(--weui-TAG-BACKGROUND-GREEN);
  --c-danger: var(--weui-RED);
  --c-warn: var(--weui-ORANGE);
  --c-warn-soft: var(--weui-TAG-BACKGROUND-ORANGE);
  --c-warn-line: var(--weui-FG-3);
  --c-warn-text: var(--weui-TAG-TEXT-ORANGE);

  --c-tabbar-bg: var(--weui-BG-1);
  --c-fab-fg: #ffffff;
  --c-knob: #ffffff;
  --c-shadow-card: none;
  --c-shadow-fab: none;

  --c-accent-deep: var(--weui-TEXTGREEN);
  --c-accent-bright: var(--weui-BRAND);
  --c-on-accent: #ffffff;
  --shadow-accent: none;

  /* ==========================================================================
     毛玻璃材质（iOS 风格）
     --------------------------------------------------------------------------
     分两层，不要混用：

     A. 面元素（在文档流里，背后只有纯灰页面）
        只做「半透明填充 + 细边 + 内高光」，不挂 backdrop-filter。
        理由：背景是 #ededed 纯色，模糊它没有任何视觉收益，
        却要为列表里每一张卡片开辟一次离屏采样，滚动直接掉帧。
        alpha 取 .78~.94，合成后仍接近 #fbfbfb，与 WEUI 纯白几乎无差，
        所以「不模糊」这件事用户看不出来。

     B. 浮层（吸顶条 / tabbar / 半屏弹层 / 模态框 / toast）
        这些背后有真实内容在滚，才值得付模糊的代价。
        填充 alpha 与模糊半径成反比：越透越要糊得狠，否则字会花。

     兼容性：backdrop-filter 在 iOS WebView 生效，微信开发者工具模拟器
     返回 none，部分安卓 X5 内核也不支持。所以填充色本身必须是可用的，
     模糊只当增益——读下面每条 alpha 时都假设它「没有模糊」也成立。
     ========================================================================== */

  /* A. 面元素 */
  --glass-bg: rgba(255, 255, 255, 0.9);        /* 常规面：卡片、区块 */
  --glass-bg-strong: rgba(255, 255, 255, 0.94); /* 需要压住底色的面：工具条、统计块 */
  --glass-bg-soft: rgba(255, 255, 255, 0.78);   /* 大块留白面：hero、空态 */
  --glass-border: var(--weui-FG-3);
  --glass-border-soft: rgba(0, 0, 0, 0.06);

  /* B. 浮层填充（light） */
  --glass-bar-fill: rgba(247, 247, 247, 0.78);    /* 薄玻璃：吸顶条 / tabbar */
  --glass-veil-fill: rgba(237, 237, 237, 0.72);   /* 页面色薄雾：只虚化、不改色相 */
  --glass-sheet-fill: rgba(255, 255, 255, 0.92);  /* 中玻璃：半屏弹层 */
  --glass-dialog-fill: rgba(255, 255, 255, 0.92); /* 厚玻璃：模态弹窗 */
  --glass-toast-fill: rgba(48, 48, 48, 0.84);     /* 深玻璃：toast（白字压暗底） */

  /* B. 浮层模糊半径。20px 是「能感觉到柔化但还看得清轮廓」的临界值，
     再小就像脏了，再大安卓端采样开销陡增。 */
  --glass-bar-blur: 20px;
  --glass-sheet-blur: 32px;
  --glass-dialog-blur: 44px;

  /* 边缘：玻璃之所以像玻璃，靠的是上沿一道高光，
     而不是模糊本身。这条线在任何平台都能画出来，是材质的骨架。 */
  --glass-edge-light: rgba(255, 255, 255, 0.72);

  /* 浮层外阴影：向上投，制造「压在内容之上」的悬浮感 */
  --glass-lift: 0 -6rpx 28rpx rgba(15, 23, 42, 0.07);

  --c-accent-glass: var(--weui-BRAND);
  --c-accent-glass-bright: var(--weui-BRAND);
  --c-accent-glass-soft: var(--weui-TAG-BACKGROUND-GREEN);
  --shadow-float: var(--glass-lift);

  /* 动效：WEUI 只用短促的状态反馈，不做整页转场 */
  --dur-fast: 120ms;
  --dur-base: 200ms;
  --ease-out: ease-out;

  /* 字排：贴近 WEUI 17px 正文 / 14px 辅助文 */
  --font-sans: -apple-system-font, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --font-mono: 'SF Mono', Menlo, Consolas, monospace;
  --fs-display: 48rpx;
  --fs-h1: 40rpx;
  --fs-title: 34rpx;
  --fs-body: 32rpx;
  --fs-caption: 28rpx;
  --fs-micro: 24rpx;
  --lh-body: 1.6;

  /* 页面水平留白：唯一来源。
     24rpx（12px）让白块离屏边有一指宽的空隙，同时白块内部仍是 WEUI 的 32rpx，
     于是「卡片边缘 24rpx / 卡片内文字 56rpx」在全站保持一致。
     页面不要自己再写左右 padding，否则内外边距会叠加。 */
  --page-gutter: 24rpx;

  /* 宽屏最大内容宽度。超出后整页居中留白，避免平板 / PC 上被拉成一条。 */
  --page-max: 100%;

  /* 间距：8 的倍数，主内边距对齐 WEUI 的 16px */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 16rpx;
  --sp-4: 32rpx;
  --sp-5: 32rpx;
  --sp-6: 48rpx;
  --sp-7: 64rpx;

  /* 圆角：全站唯一来源，大 R 角风格。
     分档按「元素在视线里的尺寸」递进，而不是按组件类型，
     这样 96rpx 的缩略图和 96px 的弹窗看起来是同一种圆法。

     换算基准：375px 宽屏幕上 1rpx = 0.5px，
     所以 48rpx = 24px、32rpx = 16px、24rpx = 12px。
     页面里不要再写裸数值，改这里整站生效。 */
  --radius-xs: 8rpx;      /*  4px：细条、文字高亮、装饰线段 */
  --radius-sm: 16rpx;     /*  8px：小徽章、色块、方形小控件 */
  --radius-md: 24rpx;     /* 12px：按钮、输入框、chip、缩略图 */
  --radius-lg: 32rpx;     /* 16px：卡片、分组容器、浮层块 */
  --radius-xl: 48rpx;     /* 24px：弹窗、半屏弹层顶角 */
  --radius-pill: 999rpx;  /* 胶囊：标签、筛选 chip、开关 */
  --radius-circle: 50%;   /* 正圆：头像、圆点、悬浮按钮 */

  /* 语义别名：调整分档时页面无需改动 */
  --radius-control: var(--radius-md);
  --radius-card: var(--radius-lg);
  --radius-sheet: var(--radius-xl);

  --h-control: 88rpx;
  --h-chip: 56rpx;
  /* WEUI Tabbar 含图标、文字与安全区留白，实测约 80px；页面底部据此预留，
     否则 .weui-footer 一类尾部内容会被固定 tabbar 盖住。 */
  --tabbar-height: 160rpx;

  /* 滚动边界氛围已随玻璃层移除；原生导航栏统一用 WEUI 平面色 */
  --edge-top-tint: transparent;
  --edge-bottom-tint: transparent;
  --edge-specular: transparent;
  --edge-glass: transparent;
  --nav-top: #f7f7f7;
  --nav-mid: #f7f7f7;
  --nav-bottom: #f7f7f7;
}

/** 深色下三层底色跟随 WEUI 暗色板，且导航栏不再做渐变三态切换 */
[data-weui-theme='dark'] {
  --nav-top: #1e1e1e;
  --nav-mid: #1e1e1e;
  --nav-bottom: #1e1e1e;

  /* 毛玻璃：暗色不是「把亮色乘个系数」，要重新配平。
     暗底上的半透明白会发灰发脏，所以填充改用中性深灰；
     alpha 反而要更高（.80~.92），因为暗色下内容与底的明度差小，
     透太多会让文字边界糊掉。
     边缘高光必须降到 .08~.12：深色玻璃的亮边只该是「一丝」，亮了就成塑料。 */
  --glass-bg: rgba(28, 28, 28, 0.9);
  --glass-bg-strong: rgba(34, 34, 34, 0.94);
  --glass-bg-soft: rgba(24, 24, 24, 0.78);
  --glass-border-soft: rgba(255, 255, 255, 0.08);

  --glass-bar-fill: rgba(22, 22, 22, 0.8);
  --glass-veil-fill: rgba(17, 17, 17, 0.72);
  --glass-sheet-fill: rgba(25, 25, 25, 0.92);
  --glass-dialog-fill: rgba(38, 38, 38, 0.92);
  --glass-toast-fill: rgba(58, 58, 58, 0.88);

  --glass-edge-light: rgba(255, 255, 255, 0.1);
  --glass-lift: 0 -6rpx 28rpx rgba(0, 0, 0, 0.34);
}
