<view class="tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tabbar__item {{current === item.key ? 'is-active' : ''}}"
    data-key="{{item.key}}"
    bindtap="onTap"
    hover-class="tabbar__item--hover"
    hover-stay-time="60"
  >
    <view class="tabbar__icon tabbar__icon--{{item.icon}}"></view>
    <text class="tabbar__label">{{item.label}}</text>
  </view>
</view>
