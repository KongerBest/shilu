/* WEUI Tabbar：贴底、无悬浮胶囊、无渐变；选中态用 weui-bar__item_on。
   图标与文字的上下居中布局写在 WXML 内联样式里，避免 WEUI 全局
   .weui-tabbar__icon{display:inline-block} 压过组件 WXSS 导致图标与文字并排。 */
.weui-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  height: auto;
  min-height: var(--tabbar-height);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--weui-FG-3);
}

.weui-tabbar__item {
  padding: 12rpx 0 40rpx;
}

.weui-tabbar__label {
  color: var(--weui-FG-1);
}

.weui-tabbar__item.weui-bar__item_on .weui-tabbar__label {
  color: var(--weui-BRAND);
}
