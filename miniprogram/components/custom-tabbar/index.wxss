.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: stretch;
  /* 全局 view 是 border-box，height 必须把安全区加进去，
     否则 padding-bottom 会从 108rpx 里扣掉 34px，图标与文字被压扁 */
  height: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--c-tabbar-bg);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--c-line);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
  transition: opacity 120ms ease;
}

.tabbar__item--hover {
  opacity: 0.6;
}

.tabbar__label {
  font-size: var(--fs-micro);
  color: var(--c-text-3);
  letter-spacing: 0.04em;
}

.tabbar__item.is-active .tabbar__label {
  color: var(--c-accent);
  font-weight: 600;
}

/* 线性图标：用 mask 把 SVG 当镂空模板，颜色由 background-color 决定，
   这样同一套图标能跟着 --c-text-3 / --c-accent 走，深浅色不用准备两份资源 */
.tabbar__icon {
  width: 44rpx;
  height: 44rpx;
  background-color: var(--c-text-3);
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  transition: background-color 120ms ease;
}

.tabbar__item.is-active .tabbar__icon {
  background-color: var(--c-accent);
}

