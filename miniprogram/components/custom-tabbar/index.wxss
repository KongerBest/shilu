/* WEUI Tabbar：贴底、无悬浮胶囊、无渐变；选中态用 weui-bar__item_on */
.weui-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  height: auto;
  min-height: var(--tabbar-height);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--weui-FG-3);
}

.weui-tabbar__item {
  padding: 12rpx 0 40rpx;
}

.weui-tabbar__icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.weui-tabbar__label {
  font-size: 24rpx;
  color: var(--weui-FG-1);
}

.weui-tabbar__item.weui-bar__item_on .weui-tabbar__label {
  color: var(--weui-BRAND);
}

/* 收缩态：只留图标，页面底部留白仍由 .page 保证 */
.weui-tabbar.is-compact .weui-tabbar__label {
  display: none;
}

.weui-tabbar.is-compact .weui-tabbar__icon {
  width: 56rpx;
  height: 56rpx;
}
