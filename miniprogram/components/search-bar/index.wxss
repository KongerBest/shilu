.sbar {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  height: 80rpx;
  padding: 0 var(--sp-4);
  background-color: var(--glass-bg);
  background-image: linear-gradient(180deg, var(--glass-bg-strong), var(--glass-bg-soft));
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-pill);
  box-shadow: var(--glass-highlight), var(--glass-ring), 0 6rpx 18rpx rgba(24, 38, 33, 0.05);
}

/* 用放大镜的极简抽象：一个圆 + 一条斜线 */
.sbar__mark {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid var(--c-text-3);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.sbar__mark::after {
  content: '';
  position: absolute;
  right: -7rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 2rpx;
  background: var(--c-text-3);
  transform: rotate(45deg);
}

.sbar__input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--c-text);
  height: 100%;
  min-width: 0;
}

.sbar__input--ro {
  display: flex;
  align-items: center;
  color: var(--c-text-3);
}

.sbar__ph {
  color: var(--c-text-3);
}

.sbar__clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--c-surface-sunken);
  position: relative;
  flex-shrink: 0;
}

.sbar__clear-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 2rpx;
  background: var(--c-text-3);
  transform: translate(-50%, -50%) rotate(45deg);
}

.sbar__clear-line--r {
  transform: translate(-50%, -50%) rotate(-45deg);
}
