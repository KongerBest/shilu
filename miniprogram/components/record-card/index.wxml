<view wx:if="{{view}}" class="weui-media-box rcard" bindtap="onTap" hover-class="weui-cell_active" hover-stay-time="60">
  <view class="weui-media-box__title rcard__title">
    {{view.title}}
    <text wx:if="{{view.is_favorite === 1}}" class="weui-badge rcard__fav">收藏</text>
  </view>
  <view wx:if="{{view.summary}}" class="weui-media-box__desc rcard__summary">{{view.summary}}</view>
  <view class="weui-media-box__info rcard__foot">
    <view class="weui-media-box__info__meta rcard__time">{{view.timeText}}</view>
    <view wx:if="{{view.metaText}}" class="weui-media-box__info__meta weui-media-box__info__meta_extra rcard__meta">{{view.metaText}}</view>
  </view>
</view>
