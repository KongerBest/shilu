<view class="rcard" wx:if="{{view}}" bindtap="onTap" hover-class="rcard--hover" hover-stay-time="60">
  <view class="rcard__top">
    <text class="rcard__title">{{view.title}}</text>
    <view wx:if="{{view.is_favorite === 1}}" class="rcard__fav"></view>
  </view>
  <text wx:if="{{view.summary}}" class="rcard__summary">{{view.summary}}</text>
  <view class="rcard__foot">
    <text class="rcard__time">{{view.timeText}}</text>
    <text wx:if="{{view.metaText}}" class="rcard__meta">{{view.metaText}}</text>
  </view>
</view>
