.rcard {
  background-color: var(--glass-bg);
  background-image:
    linear-gradient(118deg, var(--glass-specular) 0%, rgba(255, 255, 255, 0) 28%),
    linear-gradient(158deg, var(--glass-bg-strong) 0%, var(--glass-bg) 64%);
  border: 1rpx solid var(--glass-border);
  border-radius: 24rpx;
  padding: var(--sp-4);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  transition: transform 140ms ease, box-shadow 140ms ease, background-color 140ms ease;
}

.rcard--hover {
  background-color: var(--glass-bg-strong);
  transform: scale(0.994);
  box-shadow: var(--glass-highlight);
}

.rcard__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
}

.rcard__title {
  flex: 1;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
  /* 标题最多两行，超出省略，保证卡片高度可控 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.rcard__fav {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-warn);
  margin-top: 14rpx;
  flex-shrink: 0;
}

.rcard__summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
  line-height: 1.55;
}

.rcard__foot {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.rcard__time {
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.rcard__meta {
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.rcard__meta::before {
  content: '·';
  margin-right: var(--sp-1);
}
