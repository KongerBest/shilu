/* WEUI MediaBox：白色内容块、1px 分隔线、标准字号 */
.weui-media-box.rcard {
  padding: 24rpx 32rpx;
  background-color: var(--weui-BG-2);
}

.rcard__title {
  font-size: 32rpx;
  font-weight: 400;
  color: var(--weui-FG-0);
  white-space: normal;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.rcard__fav {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  vertical-align: middle;
}

.rcard__summary {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--weui-FG-1);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.rcard__foot {
  margin-top: 12rpx;
}

.rcard__time,
.rcard__meta {
  font-size: 24rpx;
  color: var(--weui-FG-2);
}
