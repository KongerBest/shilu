.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--c-text-3);
  font-size: var(--fs-caption);
}

.loading--inline {
  padding: var(--sp-4) 0;
}

/* block 模式撑满可用区，用于首屏等待，避免内容跳动 */
.loading--block {
  min-height: 60vh;
  flex-direction: column;
}

.loading__dots {
  display: flex;
  gap: 8rpx;
}

.loading__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--c-text-3);
  animation: shilu-pulse 1.2s infinite ease-in-out;
}

.loading__dot:nth-child(2) {
  animation-delay: 0.15s;
}

.loading__dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes shilu-pulse {
  0%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}
