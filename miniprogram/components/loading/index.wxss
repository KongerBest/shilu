/* WEUI Loadmore + mp-loading 官方组件，仅保留尺寸/文案微调 */
.weui-loadmore {
  width: 100%;
  margin: 32rpx auto;
  text-align: center;
}

.loading--block {
  margin: 120rpx auto;
  min-height: 50vh;
  flex-direction: column;
  justify-content: center;
}

.weui-loadmore__tips {
  color: var(--weui-FG-2);
  font-size: 28rpx;
}
