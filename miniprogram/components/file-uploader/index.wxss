/* WEUI Uploader / Cells：官方缩略图网格、输入格与文件行 */
.weui-uploader__bd {
  margin-bottom: 0;
}

.weui-uploader__files::after {
  content: '';
  display: block;
  clear: both;
}

.weui-uploader__file.tile {
  position: relative;
  width: 96px;
  height: 96px;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-control);
  background-color: var(--weui-BG-1);
}

.tile__img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-control);
}

.tile__del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-circle);
  background: rgba(0, 0, 0, 0.6);
  color: var(--weui-WHITE);
  font-size: 30rpx;
  line-height: 36rpx;
  text-align: center;
}

.tile__enc {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--weui-FG-2);
}

.tile__enc-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

.tile--progress {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile__progress {
  font-size: 26rpx;
  color: var(--weui-FG-1);
}

.tile--add.weui-uploader__input-box {
  width: 96px;
  height: 96px;
  margin-right: 0;
  border-radius: var(--radius-control);
}

.tile__hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--weui-FG-2);
}

.tile--hover {
  opacity: 0.7;
}

.file-list.weui-cells {
  margin-top: 0;
}

.file.weui-cell {
  padding: 16rpx 0;
  font-size: 30rpx;
}

.file__icon.weui-cell__hd {
  padding-right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  border: 0;
  background: transparent;
}

.file__name {
  display: block;
  font-size: 30rpx;
  color: var(--weui-FG-0);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.file__meta {
  display: block;
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

.file__del {
  font-size: 28rpx;
  color: var(--weui-RED);
}

.file-add.weui-cell_link {
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--weui-LINK);
}

.uploader__error.weui-cells__tips_warn {
  padding: 8rpx 0 16rpx;
  font-size: 26rpx;
  color: var(--weui-RED);
}

.uploader__empty.weui-cells__tips {
  padding: 4rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--weui-FG-2);
}
