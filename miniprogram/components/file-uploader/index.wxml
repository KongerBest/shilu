<view class="weui-uploader uploader">
  <view wx:if="{{loading}}" class="weui-loadmore">
    <text class="weui-loadmore__tips">加载中…</text>
  </view>

  <block wx:if="{{acceptImage}}">
    <view class="weui-uploader__bd">
      <view class="weui-uploader__files">
        <view wx:for="{{items}}" wx:key="_id" class="weui-uploader__file tile">
          <image
            wx:if="{{item.encrypted !== 1}}"
            class="tile__img"
            src="{{item.url}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="onPreview"
          />
          <view
            wx:else
            class="tile__enc"
            data-index="{{index}}"
            bindtap="onPreview"
            hover-class="tile--hover"
          >
            <icon type="info" size="24" color="#9A9A9A" />
            <text class="tile__enc-text">已加密</text>
          </view>
          <view wx:if="{{!readonly}}" class="tile__del" data-id="{{item._id}}" catchtap="onRemove">×</view>
        </view>

        <view wx:if="{{uploading}}" class="weui-uploader__file tile tile--progress">
          <text class="tile__progress tabular">{{encryptStep || (progress + '%')}}</text>
        </view>
        <view
          wx:elif="{{!readonly && items.length < limit}}"
          class="weui-uploader__input-box tile--add"
          bindtap="onAdd"
          hover-class="tile--hover"
        >
          <text class="tile__hint">{{items.length}}/{{limit}}</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="weui-cells file-list">
      <view
        wx:for="{{items}}"
        wx:key="_id"
        class="weui-cell file"
        data-index="{{index}}"
        bindtap="onFileTap"
      >
        <view class="weui-cell__hd file__icon {{item.encrypted === 1 ? 'file__icon--enc' : ''}}">
          <icon wx:if="{{item.encrypted === 1}}" type="info" size="18" color="#9A9A9A" />
          <icon wx:else type="download" size="18" color="#9A9A9A" />
        </view>
        <view class="weui-cell__bd file__main">
          <text class="file__name">{{item.name_mask}}</text>
          <text class="file__meta">{{item.encrypted === 1 ? '已加密 · ' : ''}}{{item.sizeText}}</text>
        </view>
        <view wx:if="{{!readonly}}" class="weui-cell__ft">
          <text class="file__del" data-id="{{item._id}}" catchtap="onRemove">删除</text>
        </view>
      </view>

      <view wx:if="{{uploading}}" class="weui-cell file file--progress">
        <view class="weui-cell__bd">
          <text class="file__name">{{encryptStep || ('上传中 ' + progress + '%')}}</text>
        </view>
      </view>
      <view
        wx:elif="{{!readonly && items.length < limit}}"
        class="weui-cell weui-cell_link file-add"
        bindtap="onAdd"
        hover-class="tile--hover"
      >
        + 添加文件（{{items.length}}/{{limit}}）
      </view>
    </view>
  </block>

  <view wx:if="{{readonly && !loading && items.length === 0}}" class="weui-cells__tips uploader__empty">暂无附件</view>
  <view wx:if="{{error}}" class="weui-cells__tips weui-cells__tips_warn uploader__error">{{error}}</view>
</view>
