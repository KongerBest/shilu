/* WEUI Form Cells：扁平输入框、官方分隔线、官方错误提示 */
.fr.weui-cells {
  margin-top: 0;
  background-color: transparent;
}

.fr.weui-cells::before,
.fr.weui-cells::after {
  display: none;
}

.fr-head.weui-cells__title {
  margin: 16rpx 0 8rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  color: var(--weui-FG-0);
  font-size: 30rpx;
}

.fr-label {
  color: var(--weui-FG-0);
  font-size: 30rpx;
}

.fr-required.weui-badge,
.fr-badge.weui-badge {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  border-radius: 8rpx;
  background-color: var(--weui-TAG-BACKGROUND-ORANGE);
  color: var(--weui-TAG-TEXT-ORANGE);
}

.fr-type {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

.fr-control.weui-cell,
.fr-picker.weui-cell,
.fr-datetime.weui-cell,
.fr-switch-row.weui-cell,
.fr-attachment.weui-cell,
.fr-deferred.weui-cell {
  padding: 16rpx 32rpx;
  background-color: var(--weui-BG-2);
  font-size: 32rpx;
}

.fr-control.weui-cell::before,
.fr-picker.weui-cell::before,
.fr-datetime.weui-cell::before,
.fr-switch-row.weui-cell::before,
.fr-attachment.weui-cell::before,
.fr-deferred.weui-cell::before {
  display: none;
}

.fr-attachment.weui-cell {
  display: block;
  padding-bottom: 24rpx;
}

.fr-attachment-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

.fr-input.weui-input,
.fr-textarea.weui-textarea {
  width: 100%;
  min-height: 64rpx;
  padding: 8rpx 0;
  font-size: 32rpx;
  color: var(--weui-FG-0);
  background: transparent;
  border: 0;
  border-radius: 0;
}

.fr-textarea.weui-textarea {
  min-height: 160rpx;
  line-height: 1.6;
}

.fr-input--error {
  color: var(--weui-RED);
}

.fr-placeholder-text {
  font-size: 32rpx;
  color: var(--weui-FG-2);
}

.fr-picker-value {
  font-size: 32rpx;
  color: var(--weui-FG-0);
}

.fr-chevron {
  font-size: 32rpx;
  color: var(--weui-FG-2);
}

.fr-datetime {
  display: flex;
  gap: 16rpx;
}

.fr-picker--half {
  flex: 1;
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 8rpx 16rpx;
  background-color: var(--weui-BG-1);
  border-radius: 8rpx;
}

.fr-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.fr-chip {
  padding: 8rpx 24rpx;
  font-size: 28rpx;
  color: var(--weui-FG-1);
  background-color: var(--weui-BG-1);
  border: 1rpx solid var(--weui-FG-3);
  border-radius: 8rpx;
}

.fr-chip--on {
  color: var(--weui-TEXTGREEN);
  background-color: var(--weui-TAG-BACKGROUND-GREEN);
  border-color: var(--weui-BRAND);
}

.fr-switch-text {
  font-size: 32rpx;
  color: var(--weui-FG-1);
}

.fr-deferred-title {
  display: block;
  font-size: 28rpx;
  color: var(--weui-FG-1);
}

.fr-deferred-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--weui-FG-2);
}

.fr-error.weui-cells__tips_warn {
  padding: 8rpx 32rpx 16rpx;
  color: var(--weui-RED);
  font-size: 26rpx;
}
