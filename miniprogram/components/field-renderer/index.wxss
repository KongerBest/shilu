.fr {
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--c-line);
}

.fr:last-child {
  border-bottom: none;
}

.fr-head {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-2);
}

.fr-label {
  font-size: var(--fs-body);
  color: var(--c-text);
  font-weight: 500;
}

.fr-required {
  margin-left: var(--sp-1);
  padding: 0 8rpx;
  font-size: var(--fs-micro);
  line-height: 32rpx;
  color: var(--c-danger);
  background: rgba(194, 76, 63, 0.08);
  border-radius: var(--radius-pill);
}

.fr-badge {
  margin-left: var(--sp-1);
  padding: 0 8rpx;
  font-size: var(--fs-micro);
  line-height: 32rpx;
  color: var(--c-warn);
  background: rgba(192, 138, 46, 0.1);
  border-radius: var(--radius-pill);
}

.fr-type {
  margin-left: auto;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.fr-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  font-size: var(--fs-body);
  color: var(--c-text);
  background: var(--c-surface-sunken);
  border: 1rpx solid transparent;
  border-radius: var(--radius-sm);
}

.fr-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  padding: var(--sp-2) var(--sp-3);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--c-text);
  background: var(--c-surface-sunken);
  border: 1rpx solid transparent;
  border-radius: var(--radius-sm);
}

.fr-placeholder {
  color: var(--c-text-3);
}

.fr-placeholder-text {
  color: var(--c-text-3);
  font-size: var(--fs-body);
}

.fr-input--error {
  border-color: var(--c-danger);
}

.fr-picker {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--sp-3);
  background: var(--c-surface-sunken);
  border: 1rpx solid transparent;
  border-radius: var(--radius-sm);
}

.fr-picker-value {
  font-size: var(--fs-body);
  color: var(--c-text);
}

.fr-chevron {
  font-size: 32rpx;
  color: var(--c-text-3);
}

.fr-datetime {
  display: flex;
}

.fr-picker--half {
  flex: 1;
}

.fr-datetime picker:first-child {
  margin-right: var(--sp-2);
}

.fr-chips {
  display: flex;
  flex-wrap: wrap;
}

.fr-chip {
  margin: 0 var(--sp-2) var(--sp-2) 0;
  padding: 0 var(--sp-3);
  line-height: 64rpx;
  font-size: var(--fs-caption);
  color: var(--c-text-2);
  background: var(--c-surface-sunken);
  border: 1rpx solid var(--c-line);
  border-radius: var(--radius-pill);
}

.fr-chip--on {
  color: var(--c-accent);
  background: var(--c-accent-glass-soft);
  border-color: var(--c-accent);
}

.fr-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--sp-3);
  background: var(--c-surface-sunken);
  border-radius: var(--radius-sm);
}

.fr-switch-text {
  font-size: var(--fs-body);
  color: var(--c-text-2);
}

.fr-deferred {
  padding: var(--sp-3);
  background: var(--c-surface-sunken);
  border: 1rpx dashed var(--c-line);
  border-radius: var(--radius-sm);
}

.fr-deferred-title {
  display: block;
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.fr-deferred-desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-micro);
  color: var(--c-text-3);
}

.fr-error {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-micro);
  color: var(--c-danger);
}
