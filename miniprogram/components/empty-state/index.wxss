/* WEUI Msg 官方组件（mp-msg），只补字号与留白 */
.weui-msg {
  padding-top: 96rpx;
}

.weui-msg__title {
  font-size: 40rpx;
}

.weui-msg__desc {
  font-size: 28rpx;
  color: var(--weui-FG-1);
}

/* WEUI 标准按钮宽度 184px，不用通栏 */
.weui-msg__opr-area .weui-btn.weui-btn {
  width: 184px;
  margin-left: auto;
  margin-right: auto;
}
