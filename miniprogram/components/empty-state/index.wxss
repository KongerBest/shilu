/* WEUI Msg 官方组件（mp-msg），只补字号、留白与圆角 */
.empty-wrap {
  display: block;
  /* mp-msg 自带一整块直角白底；裁剪成与页面卡片同一档的圆角 */
  border-radius: var(--radius-card);
  overflow: hidden;
}

.weui-msg {
  padding-top: 96rpx;
}

.weui-msg__title {
  font-size: 40rpx;
}

.weui-msg__desc {
  font-size: 28rpx;
  color: var(--weui-FG-1);
}

/* WEUI 标准按钮宽度 184px，不用通栏 */
.weui-msg__opr-area .weui-btn.weui-btn {
  width: 184px;
  margin-left: auto;
  margin-right: auto;
}
