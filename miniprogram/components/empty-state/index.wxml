<mp-msg type="info" size="{{64}}" title="{{title}}" desc="{{desc}}">
  <view slot="handle" wx:if="{{actionText}}" class="weui-btn-area">
    <button class="weui-btn weui-btn_primary" style="width: 184px; margin-left: auto; margin-right: auto;" hover-class="none" bindtap="onAction">{{actionText}}</button>
  </view>
</mp-msg>
