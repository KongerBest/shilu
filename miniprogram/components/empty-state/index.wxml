<view class="empty">
  <view class="empty__mark"></view>
  <text class="empty__title">{{title}}</text>
  <text wx:if="{{desc}}" class="empty__desc">{{desc}}</text>
  <view wx:if="{{actionText}}" class="empty__action" bindtap="onAction" hover-class="empty__action--hover">
    {{actionText}}
  </view>
</view>
